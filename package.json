{
  "name": "andreybolotov-ru",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "npx --yes rimraf@6 node_modules package-lock.json",
    "dev": "concurrently -n web,api -c cyan,magenta \"astro dev --host\" \"tsx watch server/index.ts\"",
    "build": "astro build",
    "preview": "astro preview --host",
    "api": "tsx server/index.ts",
    "lint": "tsc --noEmit -p tsconfig.server.json",
    "reinstall": "npx --yes rimraf@6 node_modules package-lock.json && npm cache clean --force && npm install --no-audit --no-fund"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.12",
    "nodemailer": "^6.9.16",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.18.1",
    "astro": "^4.16.18",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
