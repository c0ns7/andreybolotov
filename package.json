{
  "name": "andreybolotov-ru",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "npx --yes rimraf@6 node_modules package-lock.json",
    "dev": "concurrently -n next,api -c cyan,magenta \"next dev next-app --webpack\" \"tsx watch backend-fastify/src/index.ts\"",
    "dev:turbo": "concurrently -n next,api -c cyan,magenta \"next dev next-app\" \"tsx watch backend-fastify/src/index.ts\"",
    "build": "next build next-app",
    "start": "concurrently -n next,api -c cyan,magenta \"next start next-app -p 3000\" \"tsx backend-fastify/src/index.ts\"",
    "api": "tsx backend-fastify/src/index.ts",
    "lint": "tsc --noEmit -p tsconfig.backend-fastify.json",
    "reinstall": "npx --yes rimraf@6 node_modules package-lock.json && npm cache clean --force && npm install --no-audit --no-fund",
    "db:pg:init": "tsx scripts/pg-init.ts",
    "db:pg:migrate-from-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.2.0",
    "@hono/node-server": "^1.13.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.8.5",
    "hono": "^4.6.12",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "nodemailer": "^6.9.16",
    "pg": "^8.16.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
