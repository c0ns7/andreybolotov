---
import InstallAppModal from "./InstallAppModal.astro";
/* Модалки профиля, корзины, билетов, поиска номера — общие для /home и /home/raffle */
---

<div
  id="modal-profile"
  class="modal-overlay modal-overlay--profile"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="profile-modal-heading"
>
  <div class="profile-modal">
    <div class="profile-modal__sheet-handle" aria-hidden="true">
      <div class="cart-sheet__grabber"></div>
    </div>
    <button type="button" class="profile-modal__close" id="profile-modal-close" aria-label="Закрыть">✕</button>
    <div class="profile-modal__body">
      <div class="profile-modal__hero">
        <div class="profile-modal__avatar" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <h3 id="profile-modal-heading" class="profile-modal__title"></h3>
        <p id="profile-modal-phone-hero" class="profile-modal__phone-sub"></p>
      </div>

      <div class="profile-modal__card">
        <div class="profile-modal__field">
          <span class="profile-modal__label">Имя и Фамилия</span>
          <div id="profile-field-name" class="profile-modal__value"></div>
        </div>
        <div class="profile-modal__field">
          <span class="profile-modal__label">Телефон</span>
          <div id="profile-field-phone" class="profile-modal__value"></div>
        </div>
        <div class="profile-modal__field">
          <span class="profile-modal__label">Email</span>
          <div id="profile-field-email" class="profile-modal__value"></div>
        </div>
        <div class="profile-modal__hint">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 16v-4"></path>
            <path d="M12 8h.01"></path>
          </svg>
          <p>Если вам нужно изменить данные в профиле, обратитесь в службу поддержки.</p>
        </div>
      </div>

      <p id="profile-admin-wrap" class="profile-modal__admin" hidden>
        <a href="/admin" class="btn-admin-link" id="link-admin">Панель администратора</a>
      </p>

      <a href="/home/settings" class="profile-modal__link-settings" id="link-profile-settings">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        Настройки
      </a>

      <div class="profile-modal__actions">
        <button type="button" class="profile-modal__btn-back" id="profile-modal-dismiss">Вернуться</button>
      </div>
      <button type="button" class="profile-modal__btn-logout" id="btn-profile-logout">Выйти из аккаунта</button>
    </div>
  </div>
</div>

<div
  id="modal-raffle-unavailable"
  class="modal-overlay modal-overlay--raffle-unavailable"
  aria-hidden="true"
  role="dialog"
  aria-labelledby="raffle-unavailable-heading"
>
  <div class="modal modal--raffle-unavailable" id="modal-raffle-unavailable-inner">
    <div class="modal__top raffle-unavailable__top">
      <span></span>
      <span class="modal__top-title">Акция</span>
      <button type="button" class="modal__close raffle-unavailable__close" id="modal-raffle-unavailable-close" aria-label="Закрыть">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="raffle-unavailable__hero" aria-hidden="true">
      <div class="raffle-unavailable__glow"></div>
      <div class="raffle-unavailable__icon raffle-unavailable__icon--paused">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M10 9v6M14 9v6"></path>
        </svg>
      </div>
      <div class="raffle-unavailable__icon raffle-unavailable__icon--closed" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
    </div>
    <div class="modal__body raffle-unavailable__body">
      <h3 id="raffle-unavailable-heading" class="raffle-unavailable__heading"></h3>
      <p id="raffle-unavailable-text" class="raffle-unavailable__text"></p>
    </div>
  </div>
</div>

<div
  id="modal-cart"
  class="modal-overlay modal-overlay--cart"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-cart-title"
>
  <div class="modal modal--cart cart-sheet" id="modal-cart-sheet">
    <div class="cart-sheet__grabber" aria-hidden="true"></div>
    <div class="cart-sheet__head">
      <div class="cart-sheet__head-text">
        <h2 id="modal-cart-title" class="cart-sheet__title">Подтверждение</h2>
      </div>
      <button type="button" class="cart-sheet__close" id="modal-cart-close" aria-label="Закрыть">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
    <div class="cart-sheet__body custom-scrollbar">
      <div class="cart-sheet__section">
        <p class="cart-sheet__section-label">Номерки</p>
        <div id="modal-cart-numbers-root"></div>
      </div>
      <div class="cart-sheet__section cart-sheet__section--buyer">
        <p class="cart-sheet__section-label">Покупатель</p>
        <div class="cart-sheet__buyer" id="modal-cart-buyer">
          <div class="cart-sheet__buyer-row">
            <span class="cart-sheet__buyer-avatar" id="modal-cart-buyer-avatar" aria-hidden="true">?</span>
            <div class="cart-sheet__buyer-text">
              <span class="cart-sheet__buyer-name" id="modal-cart-buyer-name">—</span>
              <p class="cart-sheet__buyer-phone" id="modal-cart-buyer-phone">—</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="cart-sheet__footer">
      <p id="modal-cart-summary" class="cart-sheet__summary" aria-live="polite" hidden></p>
      <p id="modal-cart-multi-hint" class="cart-sheet__hint" hidden></p>
      <p id="modal-cart-tip-home" class="cart-sheet__footer-tip">💡 Несколько билетов повышают шансы</p>
      <p id="modal-cart-tip-raffle" class="cart-sheet__footer-tip" hidden>Один билетик — может, ещё парочку? 🎲</p>
      <button type="button" class="cart-sheet__cta" id="modal-cart-checkout" disabled>
        <span class="cart-sheet__cta-inner">
          <span class="cart-sheet__cta-spinner" id="modal-cart-checkout-spinner" aria-hidden="true" hidden>
            <svg class="cart-sheet__cta-spinner-svg" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="32" stroke-dashoffset="12" opacity="0.35"></circle>
              <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
            </svg>
          </span>
          <span id="modal-cart-checkout-label">Корзина пуста</span>
        </span>
      </button>
    </div>
  </div>
</div>

<div
  id="modal-reserve-success"
  class="modal-overlay modal-overlay--reserve-flow"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reserve-success-title"
>
  <div class="modal reserve-flow-modal reserve-success-modal">
    <div class="reserve-success-modal__hero" aria-hidden="true">
      <div class="reserve-success-modal__pulse"></div>
      <div class="reserve-success-modal__icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </div>
    </div>
    <h3 id="reserve-success-title" class="reserve-success-modal__title">Забронировано</h3>
    <p class="reserve-success-modal__sub">
      Номерки временно закреплены за вами. Дальше — перевод и загрузка чека. Этапы ниже подскажут, где вы сейчас.
    </p>
    <p id="reserve-success-deadline" class="reserve-flow-modal__deadline" role="status" aria-live="polite"></p>
    <nav id="reserve-success-steps" class="payment-flow-steps" aria-label="Этапы оплаты">
      <ol class="payment-flow-steps__list">
        <li class="payment-flow-steps__step">
          <span class="payment-flow-steps__num" aria-hidden="true">1</span>
          <span class="payment-flow-steps__label">Бронь</span>
        </li>
        <li class="payment-flow-steps__step">
          <span class="payment-flow-steps__num" aria-hidden="true">2</span>
          <span class="payment-flow-steps__label">Перевод</span>
        </li>
        <li class="payment-flow-steps__step">
          <span class="payment-flow-steps__num" aria-hidden="true">3</span>
          <span class="payment-flow-steps__label">Чек</span>
        </li>
      </ol>
    </nav>
    <section class="reserve-success-modal__card">
      <div class="reserve-success-modal__row reserve-success-modal__row--head">
        <span class="reserve-success-modal__label">Заказ</span>
        <span id="reserve-success-order-id" class="reserve-success-modal__order-id">—</span>
      </div>
      <div class="reserve-success-modal__row">
        <span id="reserve-success-picked-label" class="reserve-success-modal__label">Выбрано (0)</span>
      </div>
      <div id="reserve-success-numbers" class="reserve-success-modal__numbers"></div>
      <div class="reserve-success-modal__row reserve-success-modal__row--total">
        <span class="reserve-success-modal__label">К оплате</span>
        <span id="reserve-success-amount" class="reserve-success-modal__amount" aria-live="polite">0 ₽</span>
      </div>
    </section>
    <button type="button" class="reserve-flow-btn reserve-flow-btn--dark" id="reserve-success-go-pay">Шаг 2: реквизиты и оплата</button>
  </div>
</div>

<div
  id="modal-reserve-payment"
  class="modal-overlay modal-overlay--reserve-flow"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reserve-payment-title"
>
  <div class="modal reserve-flow-modal reserve-payment-modal">
    <header class="reserve-payment-modal__head">
      <button type="button" class="reserve-payment-modal__back" id="reserve-payment-back" aria-label="Назад" hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <div class="reserve-payment-modal__title-wrap">
        <h3 id="reserve-payment-title" class="reserve-payment-modal__title">Реквизиты для перевода</h3>
        <p id="reserve-payment-order-id" class="reserve-payment-modal__order-id">—</p>
      </div>
      <button type="button" class="reserve-payment-modal__close" id="reserve-payment-close" aria-label="Закрыть">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </header>

    <nav id="reserve-payment-steps" class="payment-flow-steps payment-flow-steps--compact" aria-label="Этапы оплаты">
      <ol class="payment-flow-steps__list">
        <li class="payment-flow-steps__step">
          <span class="payment-flow-steps__num" aria-hidden="true">1</span>
          <span class="payment-flow-steps__label">Бронь</span>
        </li>
        <li class="payment-flow-steps__step">
          <span class="payment-flow-steps__num" aria-hidden="true">2</span>
          <span class="payment-flow-steps__label">Перевод</span>
        </li>
        <li class="payment-flow-steps__step">
          <span class="payment-flow-steps__num" aria-hidden="true">3</span>
          <span class="payment-flow-steps__label">Чек</span>
        </li>
      </ol>
    </nav>
    <p id="reserve-payment-phase-hint" class="reserve-payment-modal__phase-hint" role="status"></p>

    <div class="reserve-payment-modal__progress-track">
      <div id="reserve-payment-progress" class="reserve-payment-modal__progress-fill"></div>
    </div>

    <div class="reserve-payment-modal__timer-row">
      <div class="reserve-payment-modal__timer" id="reserve-payment-timer">15:00</div>
      <div class="reserve-payment-modal__amount-wrap">
        <span class="reserve-payment-modal__amount-label">К ПЕРЕВОДУ</span>
        <strong id="reserve-payment-amount" class="reserve-payment-modal__amount" aria-live="polite">0 ₽</strong>
      </div>
    </div>
    <p id="reserve-payment-deadline" class="reserve-flow-modal__deadline" role="status" aria-live="polite"></p>
    <p id="reserve-payment-rules-wrap" class="reserve-payment-modal__rules" hidden>
      <a id="reserve-payment-rules-link" class="reserve-payment-modal__rules-link" href="#" target="_blank" rel="noopener noreferrer">Краткие правила акции</a>
    </p>

    <div id="reserve-payment-step-requisites">
      <section class="reserve-payment-modal__info">
        <h4>Что сделать сейчас</h4>
        <ol>
          <li>Нажмите <strong>«Перейти к оплате»</strong> — откроется сбор (Сбер) или оплатите по QR, если он есть у акции.</li>
          <li>Переведите ровно <strong id="reserve-payment-amount-inline">0 ₽</strong> — сумма должна совпадать с заказом.</li>
          <li>В комментарии к переводу укажите <strong>«Оплата услуг»</strong> (как в назначении ниже).</li>
          <li>Сохраните подтверждение: скрин или PDF из банка.</li>
          <li>Вернитесь сюда и нажмите <strong>«Я перевёл»</strong> — откроется загрузка чека (шаг 3).</li>
        </ol>
      </section>
      <section class="reserve-payment-modal__collect">
        <div class="reserve-payment-modal__collect-head">
          <span>СБОР СРЕДСТВ</span>
          <span>СБЕР</span>
        </div>
        <div class="reserve-payment-modal__collect-item">
          <span>ПОЛУЧАТЕЛЬ</span>
          <strong id="reserve-payment-recipient">—</strong>
        </div>
        <div class="reserve-payment-modal__collect-item">
          <span>НАЗНАЧЕНИЕ</span>
          <strong>Оплата услуг</strong>
        </div>
        <a id="reserve-payment-link" class="reserve-flow-btn reserve-flow-btn--green" href="#" target="_blank" rel="noopener">ПЕРЕЙТИ К ОПЛАТЕ</a>
      </section>
      <button type="button" class="reserve-flow-btn reserve-flow-btn--black" id="reserve-payment-done">Я перевёл — загрузить чек</button>
      <button type="button" class="raffle-pay-support" id="reserve-payment-support">Проблема с оплатой</button>
    </div>

    <div id="reserve-payment-step-confirm" hidden>
      <section class="reserve-payment-modal__info reserve-payment-modal__info--confirm">
        <h4>Проверьте чек перед отправкой</h4>
        <ul>
          <li>Видна <strong>дата и время</strong> операции</li>
          <li>Сумма совпадает с заказом: <strong id="reserve-payment-amount-check">0 ₽</strong></li>
          <li>Понятно, <strong>кому</strong> ушёл перевод (или последние цифры карты получателя)</li>
        </ul>
        <p class="reserve-payment-modal__info-note">
          После отправки статус сменится на «на проверке». Обычно это занимает немного времени.
        </p>
      </section>
      <label class="reserve-payment-modal__upload" for="reserve-payment-file">
        <input id="reserve-payment-file" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf" hidden />
        <span class="reserve-payment-modal__upload-title">Загрузить чек</span>
        <span id="reserve-payment-file-name" class="reserve-payment-modal__upload-sub">Фото или PDF перевода</span>
      </label>
      <button type="button" class="reserve-flow-btn reserve-flow-btn--black" id="reserve-payment-send">Отправить чек на проверку</button>
      <button type="button" class="reserve-payment-modal__back-link" id="reserve-payment-back-link">Ой, я ещё не оплатил (вернуться к реквизитам)</button>
    </div>
  </div>
</div>

<div
  id="modal-action-error"
  class="modal-overlay modal-overlay--reserve-flow"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="action-error-title"
>
  <div class="modal reserve-flow-modal reserve-expired-modal">
    <div class="reserve-expired-modal__hero" aria-hidden="true">
      <div class="reserve-expired-modal__icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </div>
    </div>
    <h3 id="action-error-title" class="reserve-expired-modal__title">Не удалось выполнить действие</h3>
    <p id="action-error-text" class="reserve-expired-modal__sub">Проверьте соединение и попробуйте снова.</p>
    <button type="button" class="reserve-flow-btn reserve-flow-btn--black" id="action-error-retry">Повторить</button>
  </div>
</div>

<div
  id="modal-wait-receipt"
  class="modal-overlay modal-overlay--reserve-flow"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="wait-receipt-title"
>
  <div class="modal reserve-flow-modal wait-receipt-modal">
    <div class="wait-receipt-modal__hero" aria-hidden="true">
      <div class="wait-receipt-modal__icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 6v6l4 2"></path>
        </svg>
      </div>
    </div>
    <h3 id="wait-receipt-title" class="wait-receipt-modal__title">Нужен чек</h3>
    <nav id="wait-receipt-steps" class="payment-flow-steps payment-flow-steps--compact" aria-label="Этапы оплаты">
      <ol class="payment-flow-steps__list">
        <li class="payment-flow-steps__step">
          <span class="payment-flow-steps__num" aria-hidden="true">1</span>
          <span class="payment-flow-steps__label">Бронь</span>
        </li>
        <li class="payment-flow-steps__step">
          <span class="payment-flow-steps__num" aria-hidden="true">2</span>
          <span class="payment-flow-steps__label">Перевод</span>
        </li>
        <li class="payment-flow-steps__step">
          <span class="payment-flow-steps__num" aria-hidden="true">3</span>
          <span class="payment-flow-steps__label">Чек</span>
        </li>
      </ol>
    </nav>
    <p class="wait-receipt-modal__sub">
      Вы отметили перевод, но чек ещё не прикреплён. Без чека заявку сложно подтвердить, а время брони ограничено — приложите файл ниже.
    </p>
    <p id="wait-receipt-amount" class="wait-receipt-modal__amount">0 ₽</p>
    <button type="button" class="reserve-flow-btn reserve-flow-btn--black" id="wait-receipt-upload">Прикрепить чек (шаг 3)</button>
    <p id="wait-receipt-left" class="wait-receipt-modal__left">Бронь держится 00:00</p>
    <p id="wait-receipt-deadline" class="reserve-flow-modal__deadline" role="status" aria-live="polite"></p>
    <p id="wait-receipt-rules-wrap" class="wait-receipt-modal__rules" hidden>
      <a id="wait-receipt-rules-link" class="reserve-payment-modal__rules-link" href="#" target="_blank" rel="noopener noreferrer">Краткие правила акции</a>
    </p>
  </div>
</div>

<div
  id="modal-reserve-expired"
  class="modal-overlay modal-overlay--reserve-flow"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reserve-expired-title"
>
  <div class="modal reserve-flow-modal reserve-expired-modal">
    <div class="reserve-expired-modal__hero" aria-hidden="true">
      <div class="reserve-expired-modal__icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </div>
    </div>
    <h3 id="reserve-expired-title" class="reserve-expired-modal__title">Время вышло</h3>
    <p class="reserve-expired-modal__sub">Бронь не была оплачена. Номерки вернулись в продажу.</p>
    <button type="button" class="reserve-flow-btn reserve-flow-btn--black" id="reserve-expired-close">Закрыть</button>
  </div>
</div>

<div
  id="modal-tickets"
  class="modal-overlay modal-overlay--tickets"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-tickets-title"
>
  <div class="modal modal--tickets-sheet">
    <div class="cart-sheet__grabber" aria-hidden="true"></div>
    <div class="tickets-sheet__header">
      <div class="tickets-sheet__header-text">
        <h2 id="modal-tickets-title" class="tickets-sheet__title">Мои билеты</h2>
        <p id="modal-tickets-subtitle" class="tickets-sheet__subtitle" hidden></p>
        <p class="tickets-sheet__hint">
          <strong>Как читать список:</strong> «Забронированные» — оплатите и загрузите чек до времени в карточке (указано по Москве). «На проверке» — чек у администратора; при необходимости замены чека заявка снова попадёт в «Забронированные» с новым сроком.
          «Утверждённые» — номерки ваши.
        </p>
      </div>
      <button type="button" class="tickets-sheet__close" id="modal-tickets-close" aria-label="Закрыть">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="tickets-sheet__body custom-scrollbar" id="modal-tickets-body"></div>
  </div>
</div>

<div
  id="modal-ticket-search"
  class="modal-overlay modal-overlay--ticket-search"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-ticket-search-title"
>
  <div class="modal ticket-search-sheet">
    <div class="ticket-search-sheet__grabber" aria-hidden="true"></div>
    <div class="ticket-search-sheet__head">
      <div class="ticket-search-sheet__head-spacer" aria-hidden="true"></div>
      <h2 id="modal-ticket-search-title" class="ticket-search-sheet__title">Поиск номера</h2>
      <button type="button" class="ticket-search-sheet__close" id="modal-ticket-search-close" aria-label="Закрыть">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
    <div class="ticket-search-sheet__body custom-scrollbar">
      <div class="ticket-search-sheet__segment" role="tablist" aria-label="Режим поиска">
        <button type="button" class="ticket-search-sheet__seg ticket-search-sheet__seg--active" id="ticket-search-mode-enter" data-mode="enter" role="tab" aria-selected="true">Ввести номер</button>
        <button type="button" class="ticket-search-sheet__seg" id="ticket-search-mode-random" data-mode="random" role="tab" aria-selected="false">Случайный выбор</button>
      </div>
      <div id="ticket-search-panel-enter">
        <h3 class="ticket-search-sheet__label">Номер билета</h3>
        <div id="ticket-search-field" class="ticket-search-sheet__field">
          <input
            id="ticket-search-input"
            class="ticket-search-sheet__input"
            type="text"
            inputmode="numeric"
            pattern="[0-9]*"
            autocomplete="off"
          />
          <span id="ticket-search-status-badge" class="ticket-search-status-badge ticket-search-status-badge--empty" aria-live="polite"></span>
        </div>
        <button type="button" class="btn btn--primary ticket-search-sheet__cta" id="ticket-search-apply" disabled>Укажите свободный номер</button>
      </div>
      <div id="ticket-search-panel-random" hidden>
        <h3 class="ticket-search-sheet__label">Количество случайных билетов</h3>
        <div class="ticket-search-random__qty" aria-label="Количество">
          <button type="button" class="ticket-search-random__step" id="ticket-search-random-minus" aria-label="Меньше">−</button>
          <span id="ticket-search-random-qty-display" class="ticket-search-random__value">5</span>
          <button type="button" class="ticket-search-random__step" id="ticket-search-random-plus" aria-label="Больше">+</button>
        </div>
        <div class="ticket-search-random__presets" role="group" aria-label="Быстрый выбор">
          <button type="button" class="ticket-search-random__preset" data-random-preset="1">1</button>
          <button type="button" class="ticket-search-random__preset" data-random-preset="3">3</button>
          <button type="button" class="ticket-search-random__preset ticket-search-random__preset--active" data-random-preset="5">5</button>
          <button type="button" class="ticket-search-random__preset" data-random-preset="10">10</button>
          <button type="button" class="ticket-search-random__preset" data-random-preset="20">20</button>
        </div>
        <button type="button" class="btn btn--primary ticket-search-sheet__cta ticket-search-sheet__cta--blue" id="ticket-search-random-apply">
          Добавить 5 случайных билетов
        </button>
      </div>
      <div id="ticket-search-picked" class="ticket-search-picked" hidden>
        <p class="ticket-search-picked__title">ВЫБРАНО:</p>
        <div id="ticket-search-picked-chips" class="ticket-search-picked__chips"></div>
        <button type="button" class="ticket-search-picked__go-cart" id="ticket-search-go-cart">Перейти в корзину</button>
      </div>
    </div>
  </div>
</div>

