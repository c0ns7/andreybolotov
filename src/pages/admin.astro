---
import AdminBase from "../layouts/AdminBase.astro";
import "../styles/admin-raffles.css";
---

<AdminBase
  title="Админка — поддержка"
  description="Панель администратора: обращения пользователей."
  extraScripts={["/js/admin-raffles.js", "/js/admin-payments.js"]}
>
  <div class="app-shell app-shell--with-tabbar app-shell--admin">
    <div class="admin-shell">
    <div class="admin-page">
      <header class="admin-head">
        <a href="/" class="admin-back">← На сайт</a>
        <p class="admin-nav-links">
          <a href="/admin" id="nav-link-support">Поддержка</a>
          <span aria-hidden="true"> · </span>
          <a href="/admin?tab=raffles" id="nav-link-raffles">Акции</a>
          <span aria-hidden="true"> · </span>
          <a href="/admin?tab=payments" id="nav-link-payments">Оплаты</a>
        </p>
        <h1 id="admin-page-heading" class="admin-title">Поддержка</h1>
        <p id="admin-page-sub" class="admin-sub">Пользователи и переписка</p>
      </header>

      <div id="admin-gate" class="admin-gate">
        <p class="admin-gate__text">Нужна авторизация с правами администратора.</p>
        <a href="/" class="btn btn--primary" style="max-width: 280px; margin: 0 auto">Открыть главную</a>
      </div>

      <div id="admin-root" hidden>
      <div id="admin-app" class="admin-app" hidden>
        <div class="admin-layout">
          <aside class="admin-sidebar">
            <h2 class="admin-sidebar__title">Пользователи</h2>
            <div class="admin-tabs" role="tablist" aria-label="Фильтр диалогов">
              <button type="button" class="admin-tab admin-tab--active" data-tab="all" role="tab" aria-selected="true">Все</button>
              <button
                type="button"
                class="admin-tab"
                data-tab="new"
                role="tab"
                aria-selected="false"
                title="Непрочитанные"
              >
                Новые
              </button>
              <button type="button" class="admin-tab" data-tab="unanswered" role="tab" aria-selected="false">Неотвеченные</button>
            </div>
            <div id="admin-user-list" class="admin-user-list custom-scrollbar"></div>
          </aside>
          <main class="admin-main">
            <div id="admin-empty" class="admin-empty">
              <p>Выберите пользователя слева</p>
            </div>
            <div id="admin-thread" class="admin-thread" hidden>
              <div class="admin-thread__head">
                <div class="admin-thread__head-text">
                  <h2 id="admin-thread-name" class="admin-thread__name"></h2>
                  <p id="admin-thread-meta" class="admin-thread__meta"></p>
                </div>
                <button type="button" class="admin-thread__edit" id="btn-admin-edit-user">Редактировать</button>
              </div>
              <div id="admin-messages" class="admin-messages custom-scrollbar"></div>
              <form id="admin-reply-form" class="admin-reply">
                <input
                  type="file"
                  id="admin-chat-file-input"
                  class="admin-reply__file"
                  hidden
                  tabindex="-1"
                  aria-hidden="true"
                  accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.zip,.txt,.mp4,.mp3,.ogg,.webm"
                />
                <button type="button" class="admin-reply__attach" id="btn-admin-chat-attach" aria-label="Прикрепить файл" title="Прикрепить файл">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.38-8.38A4 4 0 1 1 18 12.84l-8.38 8.38a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                  </svg>
                </button>
                <input
                  id="admin-reply-input"
                  class="admin-reply__input"
                  type="text"
                  placeholder="Ответ от поддержки..."
                  maxlength="4000"
                  autocomplete="off"
                />
                <button type="submit" class="admin-reply__btn">Отправить</button>
              </form>
            </div>
          </main>
        </div>
      </div>

      <div id="admin-raffles-app" class="admin-raffles-app" hidden>
        <div class="admin-raffles-toolbar">
          <div class="admin-raffles-toolbar__text">
            <span class="admin-raffles-toolbar__label">Каталог</span>
            <p class="admin-raffles-toolbar__hint">Карточки на главной идут по полю «Порядок» (меньше — выше).</p>
          </div>
          <button type="button" class="btn btn--primary admin-raffles-toolbar__btn" id="btn-raffle-new">
            <span class="admin-raffles-toolbar__btn-icon" aria-hidden="true">+</span>
            Новая акция
          </button>
        </div>
        <div class="admin-raffles-panel">
          <div id="admin-raffles-list" class="admin-raffles-list" role="list"></div>
        </div>
      </div>

      <div id="admin-payments-app" class="admin-payments-app" hidden>
        <div class="admin-raffles-toolbar">
          <div class="admin-raffles-toolbar__text">
            <span class="admin-raffles-toolbar__label">Оплаты</span>
            <p class="admin-raffles-toolbar__hint">Подтвердите или отклоните чеки — номерки закрепятся после подтверждения.</p>
          </div>
        </div>
        <div id="admin-payments-list" class="admin-payments-list"></div>
      </div>
    </div>
    </div>
    </div>

    <div id="modal-raffle-form" class="modal-overlay modal-overlay--raffle-form" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-raffle-form-title">
      <div class="modal admin-raffle-modal">
        <div class="modal__top admin-raffle-modal__top">
          <span></span>
          <h2 id="modal-raffle-form-title" class="modal__top-title">Акция</h2>
          <button type="button" class="modal__close" id="modal-raffle-form-close" aria-label="Закрыть">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="modal__body admin-raffle-modal__body">
          <form id="form-raffle" class="admin-raffle-form" novalidate>
            <input type="hidden" id="raffle-edit-id" value="" />
            <section class="admin-raffle-section" aria-labelledby="raffle-sec-main">
              <h3 id="raffle-sec-main" class="admin-raffle-section__title">Основное</h3>
              <div class="form-group">
                <label for="raffle-title">Заголовок</label>
                <input id="raffle-title" class="input" type="text" maxlength="500" required placeholder="Например: Акция с призами" autocomplete="off" />
              </div>
              <div class="form-group">
                <label for="raffle-cover-url">Обложка — ссылка</label>
                <input id="raffle-cover-url" class="input" type="url" inputmode="url" placeholder="https://…" />
              </div>
              <div class="form-group">
                <label for="raffle-cover-file">Обложка — файл</label>
                <input id="raffle-cover-file" class="input input--file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
                <p class="admin-raffle-field-hint">JPEG, PNG, WebP или GIF, до 5 МБ.</p>
              </div>
            </section>
            <section class="admin-raffle-section" aria-labelledby="raffle-sec-price">
              <h3 id="raffle-sec-price" class="admin-raffle-section__title">Цена и лимит</h3>
              <div class="form-row-2">
                <div class="form-group">
                  <label for="raffle-price">Цена билета, ₽</label>
                  <input id="raffle-price" class="input" type="number" min="0" step="1" required inputmode="numeric" />
                </div>
                <div class="form-group">
                  <label for="raffle-tickets">Количество номерков</label>
                  <input id="raffle-tickets" class="input" type="number" min="0" step="1" required inputmode="numeric" />
                </div>
              </div>
              <div class="form-group">
                <label for="raffle-old-price">Старая цена, ₽</label>
                <input
                  id="raffle-old-price"
                  class="input"
                  type="number"
                  min="0"
                  step="1"
                  inputmode="numeric"
                  placeholder="Не показывать"
                  autocomplete="off"
                />
                <p class="admin-raffle-field-hint admin-raffle-field-hint--tight">
                  Необязательно. На главной отображается зачёркнутой серым, если больше текущей цены (например 2000 при цене 1300).
                </p>
              </div>
            </section>
            <section class="admin-raffle-section" aria-labelledby="raffle-sec-pay">
              <h3 id="raffle-sec-pay" class="admin-raffle-section__title">Оплата для пользователей</h3>
              <p class="admin-raffle-section__lead">Два варианта: сбор в Сбербанке и QR на оплату ИП Болотов Н. А.</p>
              <div class="form-group">
                <label for="raffle-collection-url">Ссылка на сбор (Сбербанк)</label>
                <input id="raffle-collection-url" class="input" type="url" inputmode="url" placeholder="https://…" />
              </div>
              <div class="form-group">
                <label for="raffle-recipient">Получатель / назначение сбора</label>
                <textarea id="raffle-recipient" class="input" rows="3" maxlength="2000" placeholder="Кому перевод и на какую цель"></textarea>
              </div>
              <div class="form-group">
                <label for="raffle-qr-url">QR-код — ссылка на изображение</label>
                <input id="raffle-qr-url" class="input" type="url" inputmode="url" placeholder="https://…" />
              </div>
              <div class="form-group">
                <label for="raffle-qr-file">QR-код — файл</label>
                <input id="raffle-qr-file" class="input input--file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
                <p class="admin-raffle-field-hint">Загрузка заменит URL.</p>
              </div>
            </section>
            <section class="admin-raffle-section" aria-labelledby="raffle-sec-pub">
              <h3 id="raffle-sec-pub" class="admin-raffle-section__title">Публикация</h3>
              <div class="form-row-2">
                <div class="form-group">
                  <label for="raffle-status">Статус</label>
                  <select id="raffle-status" class="input input--select">
                    <option value="active">Активен</option>
                    <option value="closed">Продажи закрыты</option>
                    <option value="paused">Техническая пауза</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="raffle-sort">Порядок в списке</label>
                  <input id="raffle-sort" class="input" type="number" step="1" value="0" />
                  <p class="admin-raffle-field-hint admin-raffle-field-hint--tight">Меньшее число — выше на главной.</p>
                </div>
              </div>
              <div class="form-group admin-raffle-toggle-row">
                <label class="admin-toggle" for="raffle-wholesale-enabled">
                  <input id="raffle-wholesale-enabled" class="admin-toggle__input" type="checkbox" role="switch" />
                  <span class="admin-toggle__track" aria-hidden="true"></span>
                  <span class="admin-toggle__label">Оптовики</span>
                </label>
                <p class="admin-raffle-field-hint admin-raffle-field-hint--tight">
                  Учёт от 10 подтверждённых номерков в этой акции: отдельный список оптовиков (№ 1, 2, 3… по очереди) и оранжевое выделение в списке участников.
                </p>
              </div>
            </section>
            <div class="form-actions form-actions--split admin-raffle-form__actions">
              <button type="button" class="btn btn--ghost" id="btn-raffle-cancel">Отмена</button>
              <button type="submit" class="btn btn--primary" id="btn-raffle-submit">
                <span id="btn-raffle-submit-label">Сохранить</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div id="modal-raffle-participants" class="modal-overlay modal-overlay--raffle-form" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-raffle-participants-title">
      <div class="modal admin-raffle-modal">
        <div class="modal__top admin-raffle-modal__top">
          <span></span>
          <h2 id="modal-raffle-participants-title" class="modal__top-title">Участники акции</h2>
          <button type="button" class="modal__close" id="modal-raffle-participants-close" aria-label="Закрыть">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="modal__body admin-raffle-modal__body">
          <div class="admin-raffle-participants">
            <label class="form-group" for="raffle-participants-search">
              <span>Поиск по номерку</span>
              <input id="raffle-participants-search" class="input" type="search" inputmode="numeric" placeholder="Введите номерок" autocomplete="off" />
            </label>
            <div id="raffle-wholesalers-wrap" class="admin-raffle-wholesalers" hidden>
              <h3 class="admin-raffle-wholesalers__title">Оптовики</h3>
              <div id="raffle-wholesalers-list" class="admin-raffle-wholesalers__list"></div>
            </div>
            <div id="raffle-participants-list" class="admin-raffle-participants__list"></div>
          </div>
        </div>
      </div>
    </div>

    <div
      id="modal-raffle-buyer"
      class="modal-overlay modal-overlay--raffle-form modal-overlay--raffle-buyer"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-raffle-buyer-title"
    >
      <div class="modal admin-raffle-modal">
        <div class="modal__top admin-raffle-modal__top">
          <span></span>
          <h2 id="modal-raffle-buyer-title" class="modal__top-title">Покупатель</h2>
          <button type="button" class="modal__close" id="modal-raffle-buyer-close" aria-label="Закрыть">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="modal__body admin-raffle-modal__body">
          <p class="admin-raffle-buyer-modal__lead">Данные скрыты. Нажмите на блок ниже, чтобы показать.</p>
          <div
            id="raffle-buyer-reveal"
            class="admin-raffle-buyer-modal__reveal"
            role="button"
            tabindex="0"
            aria-label="Показать или скрыть данные покупателя"
          >
            <div class="admin-raffle-buyer-modal__fields">
              <div class="admin-raffle-buyer-modal__row">
                <span class="admin-raffle-buyer-modal__label">Имя</span>
                <span id="raffle-buyer-name" class="admin-raffle-buyer-modal__value"></span>
              </div>
              <div class="admin-raffle-buyer-modal__row">
                <span class="admin-raffle-buyer-modal__label">Телефон</span>
                <span id="raffle-buyer-phone" class="admin-raffle-buyer-modal__value"></span>
              </div>
              <div class="admin-raffle-buyer-modal__row">
                <span class="admin-raffle-buyer-modal__label">Email</span>
                <span id="raffle-buyer-email" class="admin-raffle-buyer-modal__value"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="modal-edit-user" class="modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="edit-user-title">
      <div class="modal admin-edit-modal">
        <div class="modal__top">
          <span></span>
          <h2 id="edit-user-title" class="modal__top-title">Данные пользователя</h2>
          <button type="button" class="modal__close" id="modal-edit-user-close" aria-label="Закрыть">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="modal__body">
          <form id="form-edit-user" novalidate>
            <div class="form-group">
              <label for="edit-user-name">Имя и фамилия</label>
              <input id="edit-user-name" class="input" type="text" autocomplete="name" maxlength="200" />
            </div>
            <div class="form-group">
              <label for="edit-user-phone">Телефон</label>
              <input id="edit-user-phone" class="input input--phone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="+7 (___) ___-__-__" />
            </div>
            <div class="form-group">
              <label for="edit-user-email">Email</label>
              <input id="edit-user-email" class="input" type="email" autocomplete="email" />
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn--primary">Сохранить</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</AdminBase>

<style is:global>
  .admin-shell {
    width: 100%;
    margin: 0 auto;
    padding: 0 12px;
    box-sizing: border-box;
  }
  .admin-page {
    padding: 16px 0;
    min-height: 100dvh;
  }
  .admin-head {
    margin-bottom: 20px;
  }
  .admin-nav-links {
    margin: 8px 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .admin-nav-links a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .admin-nav-links a[aria-current="page"] {
    color: var(--text);
    font-weight: 700;
    pointer-events: none;
  }
  .admin-back {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .admin-title {
    margin: 12px 0 4px;
    font-size: 1.35rem;
    font-weight: 700;
  }
  .admin-sub {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .admin-gate {
    text-align: center;
    padding: 40px 16px;
  }
  .admin-gate__text {
    margin-bottom: 16px;
    color: var(--text-muted);
  }
  .admin-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  @media (min-width: 700px) {
    .admin-layout {
      grid-template-columns: minmax(200px, 300px) minmax(0, 1fr);
      align-items: stretch;
    }
  }
  .admin-thread__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }
  .admin-thread__head-text {
    min-width: 0;
    flex: 1;
  }
  .admin-thread__edit {
    flex-shrink: 0;
    padding: 8px 14px;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--accent);
    cursor: pointer;
  }
  .admin-thread__edit:hover {
    background: #eff6ff;
  }
  .admin-edit-modal {
    max-width: 420px;
  }
  .admin-sidebar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    min-width: 0;
  }
  .admin-sidebar__title {
    margin: 0;
    padding: 12px 14px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }
  .admin-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 10px 10px 8px;
    border-bottom: 1px solid var(--border);
    background: #fafbfc;
  }
  .admin-tab {
    flex: 1;
    min-width: 0;
    padding: 8px 6px;
    font-size: 0.72rem;
    font-weight: 600;
    font-family: inherit;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--text-muted);
    cursor: pointer;
    line-height: 1.2;
  }
  .admin-tab--active {
    background: #eff6ff;
    border-color: #93c5fd;
    color: var(--accent);
  }
  .admin-user-list {
    max-height: 60dvh;
    overflow-x: hidden;
    overflow-y: auto;
  }
  .admin-user-item {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    text-align: left;
    padding: 12px 14px;
    border: none;
    border-bottom: 1px solid var(--border);
    background: #fff;
    cursor: pointer;
    font-family: inherit;
  }
  .admin-user-item:hover {
    background: #fafbfc;
  }
  .admin-user-item.is-active {
    background: #eff6ff;
  }
  .admin-user-item__name {
    font-weight: 600;
    font-size: 0.95rem;
    margin: 0 0 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .admin-user-item__preview {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .admin-user-item__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
  }
  .admin-user-item__row > div:first-child {
    min-width: 0;
    flex: 1;
    overflow: hidden;
  }
  .admin-user-item__badge {
    flex-shrink: 0;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: #ef4444;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 20px;
    text-align: center;
  }
  .admin-user-item__badge:empty {
    display: none;
  }
  .admin-main {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    min-height: 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
