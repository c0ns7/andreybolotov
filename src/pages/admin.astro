---
import AdminBase from "../layouts/AdminBase.astro";
import "../styles/admin-raffles.css";
---

<AdminBase
  title="Админка — поддержка"
  description="Панель администратора: обращения пользователей."
  extraScripts={["/js/admin-raffles.js", "/js/admin-payments.js", "/js/admin-users.js", "/js/admin-settings.js"]}
>
  <div class="app-shell app-shell--with-tabbar app-shell--admin">
    <div class="admin-shell">
    <div class="admin-page">
      <div id="admin-loading" class="admin-loading" aria-busy="true" aria-live="polite">
        <div class="admin-loading__spinner" aria-hidden="true"></div>
        <p class="admin-loading__text">Проверка доступа…</p>
      </div>

      <div id="admin-gate" class="admin-gate" hidden>
        <div class="admin-gate__card">
          <div class="admin-gate__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h2 class="admin-gate__title">Нет доступа</h2>
          <p class="admin-gate__text">Войдите под учётной записью администратора, чтобы открыть панель.</p>
          <a href="/" class="admin-gate__btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            На главную
          </a>
        </div>
      </div>

      <div id="admin-root" hidden>
      <header class="admin-head">
        <div class="admin-head__bar">
          <div class="admin-head__bar-top">
            <div class="admin-brand">
              <span class="admin-brand__badge" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="9" rx="1"></rect>
                  <rect x="14" y="3" width="7" height="5" rx="1"></rect>
                  <rect x="14" y="12" width="7" height="9" rx="1"></rect>
                  <rect x="3" y="16" width="7" height="5" rx="1"></rect>
                </svg>
              </span>
              <div class="admin-brand__text">
                <span class="admin-brand__label">Админ-панель</span>
                <span class="admin-brand__hint">andreybolotov.ru</span>
              </div>
            </div>
            <a href="/" class="admin-exit">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span>На сайт</span>
            </a>
          </div>

          <nav class="admin-nav" aria-label="Разделы">
            <a href="/admin" class="admin-nav__link" id="nav-link-support">
              <span class="admin-nav__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
              </span>
              <span class="admin-nav__text">Поддержка</span>
            </a>
            <a href="/admin?tab=users" class="admin-nav__link" id="nav-link-users">
              <span class="admin-nav__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </span>
              <span class="admin-nav__text">Пользователи</span>
            </a>
            <a href="/admin?tab=raffles" class="admin-nav__link" id="nav-link-raffles">
              <span class="admin-nav__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </span>
              <span class="admin-nav__text">Акции</span>
            </a>
            <a href="/admin?tab=payments" class="admin-nav__link" id="nav-link-payments">
              <span class="admin-nav__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                  <line x1="1" y1="10" x2="23" y2="10"></line>
                </svg>
              </span>
              <span class="admin-nav__text">Оплаты</span>
            </a>
            <a href="/admin?tab=settings" class="admin-nav__link" id="nav-link-settings">
              <span class="admin-nav__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
                </svg>
              </span>
              <span class="admin-nav__text">Настройки</span>
            </a>
          </nav>
        </div>

        <div class="admin-head__hero">
          <h1 id="admin-page-heading" class="admin-title">Поддержка</h1>
          <p id="admin-page-sub" class="admin-sub">Пользователи и переписка</p>
        </div>
      </header>

      <div id="admin-app" class="admin-app" hidden>
        <div class="admin-layout">
          <aside class="admin-sidebar">
            <h2 class="admin-sidebar__title">
              <span class="admin-sidebar__title-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </span>
              Диалоги
            </h2>
            <div class="admin-sidebar-search">
              <label class="visually-hidden" for="admin-support-thread-search">Поиск по телефону или тексту сообщения</label>
              <input
                id="admin-support-thread-search"
                class="input admin-sidebar-search__input"
                type="search"
                placeholder="Телефон или фраза из чата…"
                autocomplete="off"
                enterkeyhint="search"
              />
              <p class="admin-sidebar-search__hint">Сначала совпадение по номеру, иначе по тексту в сообщениях.</p>
            </div>
            <div class="admin-tabs" role="tablist" aria-label="Фильтр диалогов">
              <button type="button" class="admin-tab admin-tab--active" data-tab="all" role="tab" aria-selected="true">
                <span class="admin-tab__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                </span>
                Все
              </button>
              <button
                type="button"
                class="admin-tab"
                data-tab="new"
                role="tab"
                aria-selected="false"
                title="Непрочитанные"
              >
                <span class="admin-tab__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                </span>
                Новые
              </button>
              <button type="button" class="admin-tab" data-tab="unanswered" role="tab" aria-selected="false">
                <span class="admin-tab__icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path><path d="M13 8H7"></path><path d="M17 12H7"></path></svg>
                </span>
                Без ответа
              </button>
            </div>
            <div id="admin-user-list" class="admin-user-list custom-scrollbar"></div>
          </aside>
          <main class="admin-main">
            <div id="admin-empty" class="admin-empty">
              <div class="admin-empty__illu" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  <path d="M13 8H7"></path>
                  <path d="M17 12H7"></path>
                </svg>
              </div>
              <p>Выберите пользователя слева, чтобы открыть переписку</p>
            </div>
            <div id="admin-thread" class="admin-thread" hidden>
              <div class="admin-thread__head">
                <button
                  type="button"
                  class="admin-thread__back"
                  id="btn-admin-thread-back"
                  aria-label="Назад к списку чатов"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 18l-6-6 6-6"></path>
                  </svg>
                </button>
                <div class="admin-thread__head-text">
                  <h2 id="admin-thread-name" class="admin-thread__name"></h2>
                  <p id="admin-thread-meta" class="admin-thread__meta"></p>
                </div>
                <div class="admin-thread__actions">
                  <button
                    type="button"
                    class="admin-thread__icon-btn"
                    id="btn-admin-edit-user"
                    title="Редактировать данные"
                    aria-label="Редактировать данные пользователя"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="admin-thread__tickets-btn"
                    id="btn-admin-user-tickets"
                    title="Билеты на текущую акцию"
                    aria-label="Билеты пользователя на текущую акцию"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path>
                      <path d="M13 5v2"></path>
                      <path d="M13 17v2"></path>
                      <path d="M13 11v2"></path>
                    </svg>
                  </button>
                </div>
              </div>
              <div id="admin-chat-dropzone" class="admin-thread__body">
              <div id="admin-messages" class="admin-messages custom-scrollbar"></div>
              <form id="admin-reply-form" class="admin-reply">
                <input
                  type="file"
                  id="admin-chat-file-input"
                  class="admin-reply__file"
                  hidden
                  tabindex="-1"
                  aria-hidden="true"
                  accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.zip,.txt,.mp4,.mp3,.ogg,.webm"
                />
                <button type="button" class="admin-reply__attach" id="btn-admin-chat-attach" aria-label="Прикрепить файл" title="Прикрепить файл">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.38-8.38A4 4 0 1 1 18 12.84l-8.38 8.38a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                  </svg>
                </button>
                <div class="admin-reply__main">
                  <div class="admin-reply-canned" id="admin-reply-canned" role="toolbar" aria-label="Готовые ответы">
                    <button type="button" class="admin-reply-canned__btn" data-canned="where_order">Где заказ</button>
                    <button type="button" class="admin-reply-canned__btn" data-canned="how_receipt">Как чек</button>
                    <button type="button" class="admin-reply-canned__btn" data-canned="wait_time">Сроки</button>
                  </div>
                  <textarea
                    id="admin-reply-input"
                    class="admin-reply__textarea"
                    rows="2"
                    placeholder="Ответ от поддержки… Файл: кнопка скрепки, вставка из буфера или перетаскивание в область переписки."
                    maxlength="4000"
                    autocomplete="off"
                  ></textarea>
                </div>
                <button type="submit" class="admin-reply__btn" id="btn-admin-reply-send" aria-label="Отправить">
                  <svg class="admin-reply__btn-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
                    <path d="m21.854 2.147-10.94 10.939"></path>
                  </svg>
                  <span class="admin-reply__btn-label" aria-hidden="true">Отправить</span>
                </button>
              </form>
              </div>
            </div>
          </main>
        </div>
      </div>

      <div id="admin-raffles-app" class="admin-raffles-app" hidden>
        <div class="admin-raffles-toolbar admin-raffles-toolbar--raffles">
          <div class="admin-raffles-toolbar__lead">
            <span class="admin-raffles-toolbar__badge" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 12 20 22 4 22 4 12"></polyline>
                <rect x="2" y="7" width="20" height="5" rx="1"></rect>
                <line x1="12" y1="22" x2="12" y2="7"></line>
                <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
              </svg>
            </span>
            <div class="admin-raffles-toolbar__text">
              <span class="admin-raffles-toolbar__label">Акции на сайте</span>
              <p class="admin-raffles-toolbar__hint">
                Вкладка «Активные» — в продаже на сайте. «Скрытые» — не показываются на главной. Порядок карточек на сайте — поле «Порядок» (меньше — выше).
              </p>
            </div>
          </div>
          <button type="button" class="btn btn--primary admin-raffles-toolbar__btn" id="btn-raffle-new">
            <span class="admin-raffles-toolbar__btn-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
            Новая акция
          </button>
        </div>
        <div class="admin-raffles-tabs" role="tablist" aria-label="Фильтр акций">
          <button
            type="button"
            class="admin-raffles-tab admin-raffles-tab--active"
            id="admin-raffles-tab-active"
            role="tab"
            aria-selected="true"
            data-raffles-tab="active"
          >
            Активные
          </button>
          <button
            type="button"
            class="admin-raffles-tab"
            id="admin-raffles-tab-hidden"
            role="tab"
            aria-selected="false"
            data-raffles-tab="hidden"
          >
            Скрытые
          </button>
        </div>
        <div class="admin-raffles-panel">
          <div id="admin-raffles-list" class="admin-raffles-list" role="list"></div>
        </div>
      </div>

      <div id="admin-payments-app" class="admin-payments-app" hidden>
        <div class="admin-raffles-toolbar admin-payments-toolbar">
          <div class="admin-payments-toolbar__text">
            <span class="admin-payments-toolbar__badge" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                <line x1="1" y1="10" x2="23" y2="10"></line>
              </svg>
            </span>
            <div class="admin-raffles-toolbar__text">
              <span class="admin-raffles-toolbar__label">Очередь оплат</span>
              <p class="admin-raffles-toolbar__hint">
                Переключайте вкладки: бронь без чека и заявки с чеком на подтверждение. Сверху в списке — более ранние заявки. Отклонение чека: комментарий уходит в письмо. «Снять бронь» — полная отмена.
              </p>
            </div>
          </div>
        </div>
        <div id="admin-payments-main" class="admin-payments-main">
          <div id="admin-payments-tabs-slot" class="admin-payments-tabs-slot" aria-live="polite"></div>
          <div id="admin-payments-list" class="admin-payments-list"></div>
        </div>
      </div>

      <div id="admin-users-app" class="admin-users-app" hidden>
        <div class="admin-raffles-toolbar admin-users-toolbar">
          <div class="admin-users-toolbar__lead">
            <span class="admin-users-toolbar__badge" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
            <div class="admin-raffles-toolbar__text">
              <span class="admin-raffles-toolbar__label"
                >Пользователи <span id="admin-users-total-count" class="admin-users-toolbar__count" aria-live="polite">(…)</span></span>
              <p class="admin-raffles-toolbar__hint">Поиск по имени, телефону или email; отдельно — точный поиск по ID аккаунта. Если заполнен ID, текстовый поиск не используется. Карточки: правка профиля, чат поддержки, роль и блокировка.</p>
            </div>
          </div>
        </div>
        <div class="admin-users-search-bar">
          <label class="admin-users-search-wrap admin-users-search-wrap--main">
            <span class="visually-hidden">Поиск пользователей</span>
            <input
              id="admin-users-search"
              class="input admin-users-search"
              type="search"
              placeholder="Поиск по имени, телефону, email…"
              autocomplete="off"
            />
          </label>
          <label class="admin-users-search-wrap admin-users-search-wrap--id">
            <span class="visually-hidden">Поиск по ID аккаунта</span>
            <input
              id="admin-users-search-id"
              class="input admin-users-search-id"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              maxlength="12"
              placeholder="ID"
              title="Точный номер ID аккаунта"
            />
          </label>
        </div>
        <div id="admin-users-list" class="admin-users-list-wrap"></div>
      </div>

      <div id="admin-settings-app" class="admin-settings-app" hidden>
        <header class="admin-settings-hero">
          <div class="admin-settings-hero__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
