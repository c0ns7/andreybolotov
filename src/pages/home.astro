---
import Base from "../layouts/Base.astro";
---

<Base
  title="Андрей Болотов — приложение"
  description="Акции для авторизованных пользователей."
>
  <div class="app-shell app-shell--with-tabbar" id="app-shell">
    <div id="screen-app" class="screen home-screen screen--hidden">
      <div id="view-app-feed" class="app-view home-inner">
        <header class="home-sticky">
          <div class="home-brand-row">
            <div class="home-brand-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </div>
            <h1 class="home-brand-title">Быть добру!</h1>
          </div>
        </header>

        <div class="home-cards" id="home-cards-app"></div>
      </div>
    </div>

    <div id="panel-chat" class="panel-chat screen--hidden" aria-hidden="true">
      <div class="panel-chat__inner">
        <header class="panel-chat__head">
          <div class="panel-chat__head-left">
            <div class="panel-chat__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"></path>
              </svg>
            </div>
            <div>
              <h2 class="panel-chat__title">Поддержка</h2>
              <p class="panel-chat__status">Обычно отвечаем в течение дня</p>
            </div>
          </div>
          <button type="button" class="panel-chat__close" id="btn-chat-close" aria-label="Закрыть чат">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </header>
        <div class="panel-chat__hint" id="panel-chat-hint">Чат защищён сквозным шифрованием (RLS).</div>
        <div id="chat-messages" class="panel-chat__messages custom-scrollbar"></div>
        <form id="form-chat" class="panel-chat__form">
          <input
            type="file"
            id="chat-file-input"
            hidden
            tabindex="-1"
            aria-hidden="true"
            accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.zip,.txt,.mp4,.mp3,.ogg,.webm"
          />
          <button type="button" class="panel-chat__attach" id="btn-chat-attach" aria-label="Прикрепить файл" title="Прикрепить файл">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.38-8.38A4 4 0 1 1 18 12.84l-8.38 8.38a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
            </svg>
          </button>
          <input
            id="chat-input"
            class="panel-chat__input"
            type="text"
            autocomplete="off"
            placeholder="Сообщение..."
            maxlength="4000"
          />
          <button type="submit" class="panel-chat__send" id="btn-chat-send" aria-label="Отправить">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
              <path d="m21.854 2.147-10.94 10.939"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>

    <nav class="bottom-nav" id="bottom-nav" aria-label="Разделы приложения">
      <div class="bottom-nav__inner">
        <button type="button" class="bottom-nav-btn" id="tab-chat" aria-label="Чат">
          <span class="bottom-nav-btn__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
            </svg>
          </span>
          <span class="bottom-nav-btn__label">Чат</span>
        </button>
        <button type="button" class="bottom-nav-btn bottom-nav-btn--center" id="tab-cart" aria-label="Корзина">
          <span class="bottom-nav-btn__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 10a4 4 0 0 1-8 0"></path>
              <path d="M3.103 6.034h17.794"></path>
              <path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"></path>
            </svg>
            <span id="cart-nav-badge" class="bottom-nav-btn__badge" hidden aria-hidden="true"></span>
          </span>
          <span class="bottom-nav-btn__label">Корзина</span>
        </button>
        <button type="button" class="bottom-nav-btn" id="tab-tickets" aria-label="Билеты">
          <span class="bottom-nav-btn__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path>
              <path d="M13 5v2"></path>
              <path d="M13 17v2"></path>
              <path d="M13 11v2"></path>
            </svg>
          </span>
          <span class="bottom-nav-btn__label">Билеты</span>
        </button>
        <button type="button" class="bottom-nav-btn" id="tab-profile" aria-label="Профиль">
          <span class="bottom-nav-btn__icon">
            <span id="bottom-nav-profile-letter" style="font-size: 13px; font-weight: 900; color: #374151">К</span>
            <span class="bottom-nav-profile__dot" aria-hidden="true"></span>
          </span>
          <span class="bottom-nav-btn__label">Профиль</span>
        </button>
      </div>
    </nav>
  </div>

  <div id="modal-register" class="modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="reg-heading">
    <div class="modal">
      <div class="modal__top">
        <button type="button" class="modal__back" id="modal-reg-back" aria-label="Назад">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>
        <h2 id="reg-heading" class="modal__top-title">Регистрация</h2>
        <button type="button" class="modal__close" id="modal-reg-close" aria-label="Закрыть">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="modal__body">
        <form id="form-register" novalidate>
          <div class="form-group">
            <label for="phone-reg">Номер телефона</label>
            <input
              class="input input--phone"
              type="tel"
              id="phone-reg"
              name="phone"
              inputmode="numeric"
              autocomplete="tel"
              placeholder="+7 (___) ___-__-__"
            />
          </div>
          <div class="form-group">
            <label for="fio-reg">ФИО</label>
            <input class="input" type="text" id="fio-reg" name="fio" autocomplete="name" placeholder="Как к вам обращаться" />
          </div>
          <div class="form-group">
            <label for="email-reg">Email (для восстановления)</label>
            <input class="input" type="email" id="email-reg" name="email" autocomplete="email" placeholder="you@example.com" />
            <div class="info-hint">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"></circle>
                <path d="M12 16v-5M12 8h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
              <span>Email обязателен. На него придёт ссылка, если вы забудете пароль.</span>
            </div>
          </div>
          <div class="form-group">
            <label for="pass-reg">Придумайте пароль</label>
            <div class="input-wrap input-wrap--with-toggle">
              <input class="input" type="password" id="pass-reg" name="password" autocomplete="new-password" />
              <button type="button" class="toggle-pass" id="toggle-pass-reg" aria-label="Показать пароль" aria-pressed="false">
                <span class="eye-open" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </span>
                <span class="eye-closed" style="display: none" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path
                      d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"
                    ></path>
                    <path d="M1 1l22 22"></path>
                  </svg>
                </span>
              </button>
            </div>
          </div>
          <div class="form-group">
            <label for="pass-reg2">Повторите пароль</label>
            <div class="input-wrap input-wrap--with-toggle">
              <input class="input" type="password" id="pass-reg2" name="password2" autocomplete="new-password" />
              <button type="button" class="toggle-pass" id="toggle-pass-reg2" aria-label="Показать пароль" aria-pressed="false">
                <span class="eye-open" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </span>
                <span class="eye-closed" style="display: none" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path
                      d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"
                    ></path>
                    <path d="M1 1l22 22"></path>
                  </svg>
                </span>
              </button>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn--primary">Зарегистрироваться</button>
          </div>
          <p class="form-links">
            Уже есть аккаунт?
            <button type="button" id="link-login-from-reg">Войти</button>
          </p>
        </form>
      </div>
    </div>
  </div>

  <div id="modal-login" class="modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="login-heading">
    <div class="modal">
      <div class="modal__top">
        <button type="button" class="modal__back" id="modal-login-back" aria-label="Назад">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>
        <span></span>
        <button type="button" class="modal__close" id="modal-login-close" aria-label="Закрыть">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="modal__body">
        <div class="modal__title-block modal__title-block--with-icon">
          <div class="modal__icon-lock" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="5" y="11" width="14" height="10" rx="2"></rect>
              <path d="M8 11V8a4 4 0 018 0v3"></path>
            </svg>
          </div>
          <h2 id="login-heading" class="modal__heading">Авторизация</h2>
          <p class="modal__sub">Введите номер телефона и пароль</p>
        </div>
        <form id="form-login" novalidate>
          <div class="form-group">
            <label for="phone-login">Номер телефона</label>
            <input
              class="input input--phone"
              type="tel"
              id="phone-login"
              name="phone"
              inputmode="numeric"
              autocomplete="tel"
              placeholder="+7 (___) ___-__-__"
            />
          </div>
          <div class="form-group">
            <label for="pass-login">Пароль</label>
            <div class="input-wrap input-wrap--with-toggle">
              <input class="input" type="password" id="pass-login" name="password" autocomplete="current-password" />
              <button type="button" class="toggle-pass" id="toggle-pass-login" aria-label="Показать пароль" aria-pressed="false">
                <span class="eye-open" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </span>
                <span class="eye-closed" style="display: none" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path
                      d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"
                    ></path>
                    <path d="M1 1l22 22"></path>
                  </svg>
                </span>
              </button>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn--primary">Войти</button>
          </div>
          <p class="form-links">
            <button type="button" id="link-forgot">Забыли пароль?</button>
            <span class="block">Нет аккаунта? <button type="button" id="link-to-register">Зарегистрируйтесь</button></span>
          </p>
        </form>
      </div>
    </div>
  </div>

  <div id="modal-forgot" class="modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="forgot-heading">
    <div class="modal">
      <div class="modal__top">
        <button type="button" class="modal__back" id="modal-forgot-back" aria-label="Назад">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>
        <h2 id="forgot-heading" class="modal__top-title">Восстановление</h2>
        <button type="button" class="modal__close" id="modal-forgot-close" aria-label="Закрыть">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="modal__body">
        <p class="modal__sub" style="margin-top: 0; margin-bottom: 18px">
          Введите email, указанный при регистрации. Мы отправим на него ссылку для сброса пароля.
        </p>
        <form id="form-forgot" novalidate>
          <div class="form-group">
            <label for="email-forgot">Email</label>
            <input class="input" type="email" id="email-forgot" name="email" autocomplete="email" placeholder="you@example.com" />
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn--primary">Отправить ссылку</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div
    id="modal-profile"
    class="modal-overlay modal-overlay--profile"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="profile-modal-heading"
  >
    <div class="profile-modal">
      <button type="button" class="profile-modal__close" id="profile-modal-close" aria-label="Закрыть">✕</button>
      <div class="profile-modal__body">
        <div class="profile-modal__hero">
          <div class="profile-modal__avatar" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <h3 id="profile-modal-heading" class="profile-modal__title"></h3>
          <p id="profile-modal-phone-hero" class="profile-modal__phone-sub"></p>
        </div>

        <div class="profile-modal__card">
          <div class="profile-modal__field">
            <span class="profile-modal__label">Имя и Фамилия</span>
            <div id="profile-field-name" class="profile-modal__value"></div>
          </div>
          <div class="profile-modal__field">
            <span class="profile-modal__label">Телефон</span>
            <div id="profile-field-phone" class="profile-modal__value"></div>
          </div>
          <div class="profile-modal__field">
            <span class="profile-modal__label">Email</span>
            <div id="profile-field-email" class="profile-modal__value"></div>
          </div>
          <div class="profile-modal__hint">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 16v-4"></path>
              <path d="M12 8h.01"></path>
            </svg>
            <p>Если вам нужно изменить данные в профиле, обратитесь в службу поддержки.</p>
          </div>
        </div>

        <div class="profile-modal__stats">
          <div class="profile-modal__stat">
            <p class="profile-modal__stat-label">Ваши Билеты</p>
            <p id="profile-stat-tickets" class="profile-modal__stat-num">0</p>
          </div>
          <div class="profile-modal__stat-divider" aria-hidden="true"></div>
          <div class="profile-modal__stat">
            <p class="profile-modal__stat-label">Статус</p>
            <p id="profile-stat-status" class="profile-modal__stat-status">Активен</p>
          </div>
        </div>

        <p id="profile-admin-wrap" class="profile-modal__admin" hidden>
          <a href="/admin" class="btn-admin-link" id="link-admin">Панель администратора</a>
        </p>

        <div class="profile-modal__actions">
          <button type="button" class="profile-modal__btn-back" id="profile-modal-dismiss">Вернуться</button>
        </div>
        <button type="button" class="profile-modal__btn-logout" id="btn-profile-logout">Выйти из аккаунта</button>
      </div>
    </div>
  </div>

  <div
    id="modal-raffle-unavailable"
    class="modal-overlay modal-overlay--raffle-unavailable"
    aria-hidden="true"
    role="dialog"
    aria-labelledby="raffle-unavailable-heading"
  >
    <div class="modal modal--raffle-unavailable">
      <div class="modal__top">
        <span></span>
        <span class="modal__top-title">Акция</span>
        <button type="button" class="modal__close" id="modal-raffle-unavailable-close" aria-label="Закрыть">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="modal__body">
        <h3 id="raffle-unavailable-heading" class="raffle-unavailable__heading"></h3>
        <p id="raffle-unavailable-text" class="raffle-unavailable__text"></p>
      </div>
    </div>
  </div>

  <div
    id="modal-cart"
    class="modal-overlay modal-overlay--cart"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-cart-title"
  >
    <div class="modal modal--cart cart-sheet">
      <div class="cart-sheet__grabber" aria-hidden="true"></div>
      <div class="cart-sheet__head">
        <div class="cart-sheet__head-text">
          <h2 id="modal-cart-title" class="cart-sheet__title">Корзина</h2>
        </div>
        <button type="button" class="cart-sheet__close" id="modal-cart-close" aria-label="Закрыть">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <div class="cart-sheet__body custom-scrollbar" id="modal-cart-body"></div>
      <div class="cart-sheet__footer">
        <p id="modal-cart-multi-hint" class="cart-sheet__hint" hidden></p>
        <div class="cart-sheet__buyer" id="modal-cart-buyer">
          <p class="cart-sheet__buyer-label">Покупатель</p>
          <div class="cart-sheet__buyer-row">
            <span class="cart-sheet__buyer-avatar" id="modal-cart-buyer-avatar" aria-hidden="true">?</span>
            <div class="cart-sheet__buyer-text">
              <span class="cart-sheet__buyer-name" id="modal-cart-buyer-name">—</span>
              <p class="cart-sheet__buyer-phone" id="modal-cart-buyer-phone">—</p>
            </div>
          </div>
        </div>
        <p class="cart-sheet__footer-tip">💡 Несколько билетов повышают шансы</p>
        <button type="button" class="cart-sheet__cta" id="modal-cart-checkout" disabled>
          <span id="modal-cart-checkout-label">Корзина пуста</span>
        </button>
      </div>
    </div>
  </div>

  <div
    id="modal-tickets"
    class="modal-overlay modal-overlay--tickets"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-tickets-title"
  >
    <div class="modal modal--tickets-sheet">
      <div class="cart-sheet__grabber" aria-hidden="true"></div>
      <div class="tickets-sheet__header">
        <h2 id="modal-tickets-title" class="tickets-sheet__title">Мои билеты</h2>
        <button type="button" class="tickets-sheet__close" id="modal-tickets-close" aria-label="Закрыть">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="tickets-sheet__tabs" role="tablist" aria-label="Раздел билетов">
        <button
          type="button"
          role="tab"
          id="modal-tickets-tab-reserved"
          class="tickets-sheet__tab tickets-sheet__tab--active"
          data-tickets-tab="reserved"
          aria-selected="true"
        >
          <span class="tickets-sheet__tab-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
          </span>
          <span class="tickets-sheet__tab-label">В брони</span>
        </button>
        <button
          type="button"
          role="tab"
          id="modal-tickets-tab-confirmed"
          class="tickets-sheet__tab"
          data-tickets-tab="confirmed"
          aria-selected="false"
        >
          <span class="tickets-sheet__tab-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path>
              <path d="M13 5v2"></path>
              <path d="M13 17v2"></path>
              <path d="M13 11v2"></path>
            </svg>
          </span>
          <span class="tickets-sheet__tab-label">Купленные</span>
        </button>
      </div>
      <div class="tickets-sheet__body custom-scrollbar" id="modal-tickets-body"></div>
    </div>
  </div>
</Base>
