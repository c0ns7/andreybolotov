---
import Base from "../layouts/Base.astro";
---

<Base title="Страница не найдена" description="Перенаправление…">
  <div class="app-shell app-shell--guest" style="min-height: 40vh; padding: 48px 20px; text-align: center">
    <p style="color: var(--text-muted); margin: 0 0 16px">Переход…</p>
  </div>
  <script is:inline>
    (function () {
      try {
        var raw = localStorage.getItem("ab_auth_v2");
        var j = raw ? JSON.parse(raw) : null;
        if (j && j.token && j.phone) {
          location.replace("/home");
        } else {
          location.replace("/");
        }
      } catch (_) {
        location.replace("/");
      }
    })();
  </script>
</Base>
