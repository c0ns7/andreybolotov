---
import Base from "../../layouts/Base.astro";
---

<Base title="Акция — оплата" description="Оплата и бронирование номерков.">
  <script is:inline>
    document.documentElement.classList.add("raffle-purchase-page");
  </script>
  <div class="raffle-purchase-layout" id="raffle-purchase-layout">
    <header class="raffle-purchase-topbar">
      <button type="button" class="raffle-purchase-back" id="raffle-page-back" aria-label="Назад">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <div class="raffle-purchase-topbar__mid">
        <p id="raffle-page-topbar-title" class="raffle-purchase-topbar__title">Акция</p>
        <div id="raffle-page-checkout-bar" class="raffle-checkout-bar" hidden>
          <div id="raffle-page-checkout-numbers" class="raffle-checkout-bar__nums"></div>
          <div id="raffle-page-checkout-timer" class="raffle-checkout-bar__timer-wrap" role="status" aria-live="polite">
            <span class="raffle-checkout-bar__timer-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 6v6l4 2"></path>
              </svg>
            </span>
            <span id="raffle-page-checkout-timer-text" class="raffle-checkout-bar__timer-text"></span>
          </div>
          <button type="button" class="raffle-checkout-bar__extend btn btn--secondary btn--sm" id="raffle-page-extend" hidden>
            Продлить на 10 мин
          </button>
        </div>
      </div>
      <div class="raffle-purchase-topbar__trailing">
        <div id="raffle-page-topbar-grid-tools" class="raffle-purchase-topbar__right">
          <span id="raffle-page-tab-free" class="raffle-purchase-tab-free">— из — свободно</span>
          <button type="button" class="raffle-purchase-refresh" id="raffle-page-refresh" aria-label="Обновить список">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-3-6.7"></path>
              <path d="M21 3v7h-7"></path>
            </svg>
          </button>
        </div>
        <div class="raffle-purchase-topbar__spacer" id="raffle-page-topbar-spacer" hidden aria-hidden="true"></div>
      </div>
    </header>

    <main class="raffle-purchase-main">
      <div id="raffle-page-heading-block" class="raffle-purchase-heading-block">
        <h1 id="raffle-page-heading" class="raffle-purchase-title">Акция</h1>
        <p id="raffle-page-meta" class="raffle-purchase-meta"></p>
      </div>
      <p id="raffle-page-timer" class="raffle-detail__timer raffle-purchase-timer" hidden></p>

      <div id="raffle-page-root" class="raffle-purchase-root" data-raffle-ui="raffle-page">
        <div id="raffle-page-flow">
          <div id="raffle-page-step-grid">
            <div id="raffle-page-legend" class="raffle-legend" aria-label="Обозначения на сетке">
              <span class="raffle-legend__item">
                <span class="raffle-legend__swatch raffle-legend__swatch--free"></span>
                Свободно
              </span>
              <span class="raffle-legend__item">
                <span class="raffle-legend__swatch raffle-legend__swatch--taken"></span>
                Занято
              </span>
              <span class="raffle-legend__item">
                <span class="raffle-legend__swatch raffle-legend__swatch--sel"></span>
                Выбрано
              </span>
            </div>
            <div id="raffle-page-tabs" class="raffle-range-tabs" role="tablist" aria-label="Диапазон номерков"></div>
            <div id="raffle-page-grid" class="raffle-ticket-grid"></div>
            <div class="raffle-detail__cart-block">
              <p class="raffle-detail__cart-hint">
                <span class="raffle-detail__cart-hint-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
                    <path d="M20 3v4"></path>
                    <path d="M22 5h-4"></path>
                    <path d="M4 17v2"></path>
                    <path d="M5 18H3"></path>
                  </svg>
                </span>
                Чем больше номерков, тем больше шансов!
              </p>
              <div class="raffle-detail__bar">
                <span id="raffle-page-selection" class="raffle-detail__selection">Выбрано: 0 / 10</span>
                <button type="button" class="btn btn--primary" id="raffle-page-reserve">В корзину</button>
              </div>
            </div>
          </div>

          <div id="raffle-page-step-bank" class="raffle-detail__step" hidden>
            <p class="raffle-detail__step-title">Выберите банк</p>
            <p class="raffle-detail__step-hint">От способа зависят инструкции по оплате.</p>
            <div class="raffle-detail__bank-btns">
              <button type="button" class="btn btn--primary" data-raffle-bank="sber">Сбербанк</button>
              <button type="button" class="btn btn--ghost" data-raffle-bank="other">Другой банк</button>
            </div>
          </div>

          <div id="raffle-page-step-sber-method" class="raffle-detail__step" hidden>
            <p class="raffle-detail__step-title">Способ оплаты в Сбербанке</p>
            <p class="raffle-detail__step-hint">Выберите удобный вариант.</p>
            <div class="raffle-sber-method-btns">
              <button type="button" class="btn btn--primary raffle-sber-method-btn" data-sber-method="collection">По сбору</button>
              <button type="button" class="btn btn--primary raffle-sber-method-btn" data-sber-method="qr">По QR-коду</button>
            </div>
          </div>

          <div id="raffle-page-step-pay" class="raffle-detail__step" hidden>
            <div id="raffle-page-pay-body"></div>
            <button type="button" class="btn btn--primary raffle-detail__paid-btn" id="raffle-page-paid">Я оплатил</button>
          </div>

          <div id="raffle-page-step-wait" class="raffle-detail__step raffle-detail__wait" hidden>
            <p>Чек отправлен на проверку. Номерки остаются за вами до решения администратора.</p>
            <p class="raffle-detail__wait-sub">После подтверждения оплаты билеты закрепляются окончательно.</p>
          </div>
        </div>
      </div>
    </main>
  </div>
</Base>
