---
import Base from "../../layouts/Base.astro";
import AppDockNav from "../../components/AppDockNav.astro";
import AppDockModals from "../../components/AppDockModals.astro";
---

<Base title="Акция — оплата" description="Оплата и бронирование номерков.">
  <script is:inline>
    document.documentElement.classList.add("raffle-purchase-page", "raffle-grid-page");
  </script>
  <div class="app-shell app-shell--with-tabbar" id="app-shell">
  <div class="raffle-purchase-layout" id="raffle-purchase-layout">
    <header class="raffle-purchase-hero" id="raffle-page-hero">
      <div class="raffle-purchase-hero__bg" aria-hidden="true">
        <div class="raffle-purchase-hero__watermark" aria-hidden="true"></div>
      </div>
      <div class="raffle-purchase-hero__bar">
        <button type="button" class="raffle-purchase-back raffle-purchase-back--hero" id="raffle-page-back" aria-label="Назад на главную">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>
        <div class="raffle-purchase-hero__mid">
          <div id="raffle-page-heading-block" class="raffle-purchase-hero-head">
            <h1 id="raffle-page-heading" class="raffle-purchase-title raffle-purchase-title--hero">Акция</h1>
            <p id="raffle-page-price-badge" class="raffle-price-badge raffle-price-badge--hero" hidden></p>
          </div>
          <div id="raffle-page-checkout-head" class="raffle-purchase-hero-checkout-head" hidden>
            <p id="raffle-page-checkout-title" class="raffle-purchase-title raffle-purchase-title--hero">Акция</p>
          </div>
          <div id="raffle-page-checkout-bar" class="raffle-checkout-bar raffle-checkout-bar--hero" hidden>
            <div id="raffle-page-checkout-numbers" class="raffle-checkout-bar__nums"></div>
            <div id="raffle-page-checkout-timer" class="raffle-checkout-bar__timer-wrap" role="status" aria-live="polite">
              <span class="raffle-checkout-bar__timer-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 6v6l4 2"></path>
                </svg>
              </span>
              <span id="raffle-page-checkout-timer-text" class="raffle-checkout-bar__timer-text"></span>
            </div>
            <button type="button" class="raffle-checkout-bar__extend btn btn--secondary btn--sm" id="raffle-page-extend" hidden>
              Продлить на 10 мин
            </button>
          </div>
        </div>
        <div class="raffle-purchase-hero-viewers" id="raffle-page-viewers" hidden aria-live="polite">
          <span class="raffle-purchase-hero-viewers__dot" aria-hidden="true"></span>
          <span id="raffle-page-viewers-text">Онлайн: 0</span>
        </div>
      </div>
      <div class="raffle-purchase-hero__controls">
        <div id="raffle-fast-input" class="raffle-fast-input" aria-label="Быстрый набор номерка">
          <button
            type="button"
            class="raffle-fast-input__random"
            id="raffle-fast-random"
            title="Случайный свободный билет"
            aria-label="Случайный свободный билет"
          >
            <img src="/dice.png" alt="Random" width="30" height="30" />
          </button>
          <div class="raffle-fast-input__divider" aria-hidden="true"></div>
          <input
            id="raffle-fast-number"
            class="raffle-fast-input__field"
            type="number"
            inputmode="decimal"
            placeholder="Быстрый набор номерка"
            min="1"
          />
          <div class="raffle-fast-input__state" id="raffle-fast-state"></div>
        </div>
        <div class="raffle-range-toolbar">
          <button
            type="button"
            class="raffle-range-eye"
            id="raffle-page-only-free"
            aria-pressed="false"
            title="Показывать только свободные"
            aria-label="Показывать только свободные"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
          <div id="raffle-page-tabs" class="raffle-range-tabs" role="tablist" aria-label="Диапазон номерков"></div>
        </div>
      </div>
    </header>
    <div class="raffle-legend-island-wrap">
      <div id="raffle-page-legend" class="raffle-legend raffle-legend--island" aria-label="Обозначения на сетке">
        <span class="raffle-legend__item">
          <span class="raffle-legend__swatch raffle-legend__swatch--free"></span>
          Свободно
        </span>
        <span class="raffle-legend__item">
          <span class="raffle-legend__swatch raffle-legend__swatch--sel"></span>
          Ваш выбор
        </span>
        <span class="raffle-legend__item">
          <span class="raffle-legend__swatch raffle-legend__swatch--taken"></span>
          Забронировано
        </span>
      </div>
    </div>

    <main class="raffle-purchase-main">
      <p id="raffle-page-timer" class="raffle-detail__timer raffle-purchase-timer" hidden></p>

      <div id="raffle-page-root" class="raffle-purchase-root raffle-purchase-panel" data-raffle-ui="raffle-page">
        <div id="raffle-page-flow">
          <div id="raffle-page-step-grid">
            <div id="raffle-page-grid" class="raffle-ticket-grid"></div>
          </div>

          <div id="raffle-page-step-bank" class="raffle-detail__step" hidden>
            <p class="raffle-detail__step-title">Выберите банк</p>
            <p class="raffle-detail__step-hint">От способа зависят инструкции по оплате.</p>
            <div class="raffle-detail__bank-btns">
              <button type="button" class="btn btn--primary" data-raffle-bank="sber">Сбербанк</button>
              <button type="button" class="btn btn--ghost" data-raffle-bank="other">Другой банк</button>
            </div>
          </div>

          <div id="raffle-page-step-sber-method" class="raffle-detail__step" hidden>
            <p class="raffle-detail__step-title">Способ оплаты в Сбербанке</p>
            <p class="raffle-detail__step-hint">Выберите удобный вариант.</p>
            <div class="raffle-sber-method-btns">
              <button type="button" class="btn btn--primary raffle-sber-method-btn" data-sber-method="collection">По сбору</button>
              <button type="button" class="btn btn--primary raffle-sber-method-btn" data-sber-method="qr">По QR-коду</button>
            </div>
          </div>

          <div id="raffle-page-step-pay" class="raffle-detail__step" hidden>
            <div id="raffle-page-pay-body"></div>
            <button type="button" class="btn btn--primary raffle-detail__paid-btn" id="raffle-page-paid">Я оплатил</button>
          </div>

          <div id="raffle-page-step-wait" class="raffle-detail__step raffle-detail__wait" hidden>
            <p>Чек отправлен на проверку. Номерки остаются за вами до решения администратора.</p>
            <p class="raffle-detail__wait-sub">После подтверждения оплаты билеты закрепляются окончательно.</p>
          </div>
        </div>
      </div>
    </main>
  </div>
  <AppDockNav />
  </div>
  <AppDockModals />
</Base>
