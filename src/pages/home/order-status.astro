---
import Base from "../../layouts/Base.astro";
---

<Base title="Статус заказа" description="Проверка статуса заявки по ссылке из SMS или письма.">
  <div class="app-shell app-shell--simple" id="app-shell">
    <div class="order-status-page screen home-screen">
      <div class="order-status-page__inner home-inner">
        <header class="order-status-page__head">
          <a href="/home" class="order-status-page__back" aria-label="На главную">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
          </a>
          <h1 class="order-status-page__title">Статус заказа</h1>
        </header>
        <div id="order-status-root" class="order-status-root" role="status" aria-live="polite">
          <p class="order-status-loading">Загрузка…</p>
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    (function () {
      var root = document.getElementById("order-status-root");
      if (!root) return;
      var params;
      try {
        params = new URLSearchParams(window.location.search);
      } catch (_) {
        params = null;
      }
      var t = params ? String(params.get("t") || "").trim() : "";
      function esc(s) {
        return String(s)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }
      function fmt(ms) {
        var n = Number(ms);
        if (!Number.isFinite(n) || n <= 0) return "—";
        try {
          return new Date(n).toLocaleString("ru-RU", {
            day: "numeric",
            month: "short",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit",
          });
        } catch (_) {
          return "—";
        }
      }
      function statusRu(st) {
        var s = String(st || "");
        if (s === "reserved") return "Бронь, ждём оплату и чек";
        if (s === "pending_review") return "Чек на проверке";
        if (s === "confirmed") return "Оплата подтверждена";
        if (s === "rejected") return "Заявка отменена";
        return s || "—";
      }
      if (!t) {
        root.innerHTML =
          '<div class="order-status-card order-status-card--err">' +
          "<p><strong>Ссылка неполная</strong></p>" +
          "<p class=\"order-status-muted\">Откройте страницу из SMS или письма целиком. Если ссылка обрезана, попросите отправить её ещё раз.</p>" +
          "</div>";
        return;
      }
      fetch("/api/public/raffle-order-status?t=" + encodeURIComponent(t), { cache: "no-store" })
        .then(function (r) {
          return r.json().then(function (d) {
            return { ok: r.ok, d: d };
          });
        })
        .then(function (x) {
          if (!x.ok || !x.d || x.d.found !== true) {
            root.innerHTML =
              '<div class="order-status-card order-status-card--err">' +
              "<p><strong>Заказ не найден</strong></p>" +
              "<p class=\"order-status-muted\">Возможно, ссылка устарела или была скопирована с ошибкой.</p>" +
              "</div>";
            return;
          }
          var d = x.d;
          var rules = d.rules_url ? String(d.rules_url).trim() : "";
          var rulesBlock = rules
            ? '<p class="order-status-rules"><a href="' +
              esc(rules) +
              '" target="_blank" rel="noopener noreferrer">Краткие правила акции</a></p>'
            : "";
          var hint = d.review_eta_hint ? '<p class="order-status-eta">' + esc(String(d.review_eta_hint)) + "</p>" : "";
          var tl = Array.isArray(d.timeline) ? d.timeline : [];
          var tlHtml = "";
          if (tl.length) {
            tlHtml += '<div class="order-status-timeline"><p class="order-status-timeline__title">История</p><ol class="order-status-timeline__list">';
            for (var i = 0; i < tl.length; i++) {
              var it = tl[i] || {};
              var det = it.detail ? '<span class="order-status-timeline__detail">' + esc(String(it.detail)) + "</span>" : "";
              tlHtml +=
                "<li><strong>" +
                esc(String(it.label || it.kind || "")) +
                "</strong><span class=\"order-status-timeline__time\">" +
                esc(fmt(it.at)) +
                "</span>" +
                det +
                "</li>";
            }
            tlHtml += "</ol></div>";
          }
          var until =
            d.reserved_until != null && Number(d.reserved_until) > 0
              ? '<p class="order-status-muted">Снять бронь нужно до <strong>' +
                esc(fmt(d.reserved_until)) +
                "</strong> (время браузера).</p>"
              : "";
          root.innerHTML =
            '<div class="order-status-card">' +
            "<p class=\"order-status-pill\">" +
            esc(String(d.order_public_id || "")) +
            "</p>" +
            "<h2 class=\"order-status-h2\">" +
            esc(String(d.raffle_title || "Акция")) +
            "</h2>" +
            "<p class=\"order-status-status\"><strong>Статус:</strong> " +
            esc(statusRu(d.status)) +
            "</p>" +
            "<p class=\"order-status-sum\">Сумма: <strong>" +
            esc(String(d.amount_rub ?? "—")) +
            " ₽</strong> · номерков: <strong>" +
            esc(String(d.ticket_count ?? "—")) +
            "</strong></p>" +
            until +
            hint +
            rulesBlock +
            tlHtml +
            "</div>";
        })
        .catch(function () {
          root.innerHTML =
            '<div class="order-status-card order-status-card--err">' +
            "<p><strong>Не удалось загрузить</strong></p>" +
            "<p class=\"order-status-muted\">Проверьте соединение и откройте страницу снова.</p>" +
            "</div>";
        });
    })();
  </script>
  <style>
    .order-status-page {
      min-height: 100dvh;
      padding: 16px 16px 32px;
    }
    .order-status-page__inner {
      max-width: 520px;
      margin: 0 auto;
    }
    .order-status-page__head {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }
    .order-status-page__back {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      color: var(--text, #0f172a);
      background: var(--surface-elevated, #f8fafc);
      border: 1px solid var(--border, #e2e8f0);
    }
    .order-status-page__title {
      margin: 0;
      font-size: 1.25rem;
      font-weight: 800;
    }
    .order-status-loading {
      margin: 0;
      color: var(--text-muted, #64748b);
      font-size: 0.9rem;
    }
    .order-status-card {
      border-radius: 16px;
      border: 1px solid var(--border, #e2e8f0);
      background: var(--surface, #fff);
      padding: 18px 18px 20px;
    }
    .order-status-card--err {
      border-color: #fecaca;
      background: #fef2f2;
    }
    .order-status-pill {
      display: inline-block;
      margin: 0 0 8px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      background: #eef2ff;
      color: #4338ca;
    }
    .order-status-h2 {
      margin: 0 0 10px;
      font-size: 1.05rem;
      font-weight: 800;
      line-height: 1.3;
    }
    .order-status-status {
      margin: 0 0 8px;
      font-size: 0.92rem;
    }
    .order-status-sum {
      margin: 0 0 10px;
      font-size: 0.88rem;
      color: var(--text-muted, #64748b);
    }
    .order-status-muted {
      margin: 0 0 12px;
      font-size: 0.82rem;
      line-height: 1.45;
      color: var(--text-muted, #64748b);
    }
    .order-status-eta {
      margin: 0 0 12px;
      padding: 10px 12px;
      border-radius: 10px;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      font-size: 0.84rem;
      color: #166534;
    }
    .order-status-rules {
      margin: 0 0 14px;
      font-size: 0.88rem;
    }
    .order-status-rules a {
      font-weight: 700;
      color: #2563eb;
    }
    .order-status-timeline {
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--border, #e2e8f0);
    }
    .order-status-timeline__title {
      margin: 0 0 8px;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted, #64748b);
    }
    .order-status-timeline__list {
      margin: 0;
      padding-left: 1.15rem;
      font-size: 0.82rem;
      line-height: 1.45;
      color: var(--text, #334155);
    }
    .order-status-timeline__list li {
      margin-bottom: 10px;
    }
    .order-status-timeline__time {
      display: block;
      font-size: 0.75rem;
      color: var(--text-muted, #94a3b8);
      margin-top: 2px;
    }
    .order-status-timeline__detail {
      display: block;
      margin-top: 4px;
      font-size: 0.78rem;
      color: var(--text-muted, #64748b);
    }
  </style>
</Base>
