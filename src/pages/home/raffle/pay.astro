---
import Base from "../../../layouts/Base.astro";
---

<Base title="Оплата" description="Оплата номерков по акции.">
  <script is:inline>
    document.documentElement.classList.add("raffle-purchase-page");
  </script>
  <div class="raffle-purchase-layout raffle-purchase-layout--pay-screen" id="raffle-purchase-layout">
    <header class="raffle-pay-screen-topbar">
      <button type="button" class="raffle-purchase-back" id="raffle-page-back" aria-label="Назад">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <h1 class="raffle-pay-screen-topbar__title" id="raffle-pay-page-title">Оплата</h1>
      <div class="raffle-pay-screen-topbar__spacer" aria-hidden="true"></div>
    </header>

    <main class="raffle-pay-screen-main">
      <div id="raffle-pay-main-block">
        <p class="raffle-pay-screen__label">Ваши номерки</p>
        <div id="raffle-pay-numbers" class="raffle-pay-numbers"></div>
        <div class="raffle-pay-screen__timer-row">
          <div id="raffle-page-checkout-timer" class="raffle-checkout-bar__timer-wrap raffle-pay-screen__timer" role="status" aria-live="polite">
            <span class="raffle-checkout-bar__timer-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 6v6l4 2"></path>
              </svg>
            </span>
            <span id="raffle-page-checkout-timer-text" class="raffle-checkout-bar__timer-text"></span>
          </div>
          <button type="button" class="raffle-pay-extend-icon" id="raffle-page-extend" title="Продлить бронь на 10 минут" hidden>
            +10
          </button>
        </div>
      </div>

      <p id="raffle-page-timer" class="raffle-detail__timer raffle-purchase-timer" hidden></p>

      <div id="raffle-page-root" class="raffle-purchase-root" data-raffle-ui="raffle-pay-page">
        <div id="raffle-page-flow">
          <div id="raffle-page-step-bank" class="raffle-detail__step" hidden>
            <p class="raffle-detail__step-title">Выберите банк</p>
            <p class="raffle-detail__step-hint">От способа зависят инструкции по оплате.</p>
            <div class="raffle-detail__bank-btns">
              <button type="button" class="btn btn--primary" data-raffle-bank="sber">Сбербанк</button>
              <button type="button" class="btn btn--ghost" data-raffle-bank="other">Другой банк</button>
            </div>
          </div>

          <div id="raffle-page-step-sber-method" class="raffle-detail__step" hidden>
            <p class="raffle-detail__step-title">Способ оплаты в Сбербанке</p>
            <p class="raffle-detail__step-hint">Выберите удобный вариант.</p>
            <div class="raffle-sber-method-btns">
              <button type="button" class="btn btn--primary raffle-sber-method-btn" data-sber-method="collection">По сбору</button>
              <button type="button" class="btn btn--primary raffle-sber-method-btn" data-sber-method="qr">По QR-коду</button>
            </div>
          </div>

          <div id="raffle-page-step-pay" class="raffle-detail__step" hidden>
            <div id="raffle-page-pay-body"></div>
            <button type="button" class="btn btn--primary raffle-detail__paid-btn" id="raffle-page-paid">Я оплатил</button>
          </div>

          <div id="raffle-page-step-wait" class="raffle-detail__step raffle-detail__wait" hidden>
            <p>Чек отправлен на проверку. Номерки остаются за вами до решения администратора.</p>
            <p class="raffle-detail__wait-sub">После подтверждения оплаты билеты закрепляются окончательно.</p>
          </div>
        </div>
      </div>
    </main>
  </div>
</Base>
