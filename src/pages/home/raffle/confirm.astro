---
import Base from "../../../layouts/Base.astro";
---

<Base title="Подтверждение платежа" description="Прикрепите чек для проверки.">
  <script is:inline>
    document.documentElement.classList.add("raffle-confirm-page");
  </script>
  <div class="raffle-confirm-layout" id="raffle-confirm-layout">
    <header class="raffle-confirm-topbar">
      <button type="button" class="raffle-confirm-back" id="raffle-confirm-back" aria-label="Назад к оплате">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <h1 class="raffle-confirm-topbar__title">Подтверждение платежа</h1>
      <span class="raffle-confirm-topbar__spacer" aria-hidden="true"></span>
    </header>
    <main class="raffle-confirm-main">
      <p id="raffle-confirm-lead" class="raffle-confirm-lead"></p>
      <div class="raffle-confirm-attach-wrap">
        <label class="raffle-confirm-file-label" for="raffle-confirm-file">
          <span class="raffle-confirm-file-label__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" x2="12" y1="3" y2="15"></line>
            </svg>
          </span>
          <span class="raffle-confirm-file-label__text">Прикрепить чек</span>
          <span id="raffle-confirm-file-name" class="raffle-confirm-file-name"></span>
        </label>
        <input type="file" id="raffle-confirm-file" class="raffle-confirm-file-input" accept="image/*,application/pdf" />
      </div>
      <p class="raffle-confirm-hint">
        На чеке должны быть видны дата, сумма, получатель и назначение платежа (при оплате по QR).
      </p>
      <button type="button" class="btn btn--primary raffle-confirm-submit" id="raffle-confirm-send">Отправить на проверку</button>
    </main>
  </div>
</Base>
