---
import Base from "../../layouts/Base.astro";
import AppDockNav from "../../components/AppDockNav.astro";
import AppDockModals from "../../components/AppDockModals.astro";
---

<Base title="Настройки" description="Пароль, тема, уведомления на почту и доступность.">
  <div class="app-shell app-shell--with-tabbar" id="app-shell">
    <div class="settings-page screen home-screen" id="settings-page-root">
      <div class="settings-page__inner home-inner">
        <header class="settings-page__head">
          <a href="/home" class="settings-page__back" aria-label="Назад в приложение">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
          </a>
          <h1 class="settings-page__title">Настройки</h1>
        </header>

        <nav class="settings-tabs" role="tablist" aria-label="Разделы настроек">
          <button type="button" class="settings-tab" role="tab" id="tab-settings-password" data-tab="password" aria-selected="true" aria-controls="settings-panel-password">
            Пароль
          </button>
          <button type="button" class="settings-tab" role="tab" id="tab-settings-theme" data-tab="theme" aria-selected="false" aria-controls="settings-panel-theme" tabindex="-1">
            Тема
          </button>
          <button type="button" class="settings-tab" role="tab" id="tab-settings-notify" data-tab="notify" aria-selected="false" aria-controls="settings-panel-notify" tabindex="-1">
            Почта
          </button>
          <button type="button" class="settings-tab" role="tab" id="tab-settings-a11y" data-tab="a11y" aria-selected="false" aria-controls="settings-panel-a11y" tabindex="-1">
            Доступность
          </button>
        </nav>

        <div id="settings-panel-password" class="settings-tab-panel" role="tabpanel" aria-labelledby="tab-settings-password">
          <div class="settings-card">
            <h2 class="settings-card__title">Смена пароля</h2>
            <p class="settings-card__lead">Укажите текущий пароль и новый. После сохранения вход по-прежнему по телефону.</p>
            <p id="settings-password-error" class="settings-msg settings-msg--err" hidden></p>
            <p id="settings-password-ok" class="settings-msg settings-msg--ok" hidden>Пароль обновлён.</p>
            <form id="form-settings-password" novalidate>
              <div class="form-group">
                <label for="settings-current-password">Текущий пароль</label>
                <input class="input" type="password" id="settings-current-password" autocomplete="current-password" required />
              </div>
              <div class="form-group">
                <label for="settings-new-password">Новый пароль</label>
                <input class="input" type="password" id="settings-new-password" autocomplete="new-password" minlength="6" required />
              </div>
              <div class="form-group">
                <label for="settings-new-password2">Новый пароль ещё раз</label>
                <input class="input" type="password" id="settings-new-password2" autocomplete="new-password" minlength="6" required />
              </div>
              <div class="form-actions">
                <button type="submit" class="btn btn--primary" id="settings-password-submit">Сохранить пароль</button>
              </div>
            </form>
          </div>
        </div>

        <div id="settings-panel-theme" class="settings-tab-panel" role="tabpanel" aria-labelledby="tab-settings-theme" hidden>
          <div class="settings-card">
            <h2 class="settings-card__title">Оформление</h2>
            <p class="settings-card__lead">Светлая тема удобна днём, тёмная — вечером и в слабоосвещённых помещениях. Выбор сохраняется на этом устройстве.</p>
            <div class="settings-seg" role="group" aria-label="Тема приложения">
              <button type="button" class="settings-seg__btn settings-seg__btn--active" id="settings-theme-light" aria-pressed="true">Светлая</button>
              <button type="button" class="settings-seg__btn" id="settings-theme-dark" aria-pressed="false">Тёмная</button>
            </div>
          </div>
        </div>

        <div id="settings-panel-notify" class="settings-tab-panel" role="tabpanel" aria-labelledby="tab-settings-notify" hidden>
          <div class="settings-card">
            <h2 class="settings-card__title">Уведомления на почту</h2>
            <p class="settings-card__lead">Письма уходят на адрес из вашего профиля. Пароль и важные письма по безопасности приходят всегда.</p>
            <p id="settings-notify-error" class="settings-msg settings-msg--err" hidden></p>
            <label class="settings-option">
              <input type="checkbox" id="settings-notify-chat" />
              <span class="settings-option__text">
                <span class="settings-option__label">Чат поддержки</span>
                <span class="settings-option__hint">Когда поддержка ответит в чате, на почту сразу придёт письмо с текстом этого ответа.</span>
              </span>
            </label>
            <label class="settings-option">
              <input type="checkbox" id="settings-notify-raffles" />
              <span class="settings-option__text">
                <span class="settings-option__label">Новые акции на сайте</span>
                <span class="settings-option__hint">Одно письмо, когда акция становится доступна на главной.</span>
              </span>
            </label>
            <label class="settings-option">
              <input type="checkbox" id="settings-notify-raffle-orders" />
              <span class="settings-option__text">
                <span class="settings-option__label">Бронь и оплата</span>
                <span class="settings-option__hint">Напоминание, что бронь скоро сгорит; письмо, если чек нужно заменить. Не зависит от рассылки о новых акциях.</span>
              </span>
            </label>
          </div>
        </div>

        <div id="settings-panel-a11y" class="settings-tab-panel" role="tabpanel" aria-labelledby="tab-settings-a11y" hidden>
          <div class="settings-card">
            <h2 class="settings-card__title">Для слабовидящих</h2>
            <p class="settings-card__lead">Настройки ниже увеличивают читаемость интерфейса. Их можно комбинировать.</p>
            <label class="settings-option">
              <input type="checkbox" id="settings-a11y-large" />
              <span class="settings-option__text">
                <span class="settings-option__label">Крупный текст</span>
                <span class="settings-option__hint">Увеличивает базовый размер шрифта во всём приложении.</span>
              </span>
            </label>
            <label class="settings-option">
              <input type="checkbox" id="settings-a11y-contrast" />
              <span class="settings-option__text">
                <span class="settings-option__label">Повышенный контраст</span>
                <span class="settings-option__hint">Более чёткие границы и насыщенные цвета текста.</span>
              </span>
            </label>
            <label class="settings-option">
              <input type="checkbox" id="settings-a11y-motion" />
              <span class="settings-option__text">
                <span class="settings-option__label">Меньше анимации</span>
                <span class="settings-option__hint">Сокращает движение и плавные переходы — удобнее при чувствительности к анимации.</span>
              </span>
            </label>
          </div>
        </div>
      </div>
    </div>
    <AppDockNav />
  </div>
  <AppDockModals />
  <script src="/js/settings-page.js" defer></script>
</Base>
