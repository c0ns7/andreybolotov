---
import Base from "../../layouts/Base.astro";
---

<Base title="Новый пароль" description="Установите новый пароль по ссылке из письма.">
  <div class="reset-pw-page">
    <div class="reset-pw-card">
      <h1 class="reset-pw-title">Новый пароль</h1>
      <p id="reset-pw-lead" class="reset-pw-lead">Введите новый пароль для входа по телефону.</p>
      <p id="reset-pw-error" class="reset-pw-error" hidden></p>
      <form id="form-reset-pw" class="reset-pw-form" novalidate>
        <label class="reset-pw-label" for="reset-pw-pass">Пароль</label>
        <input
          class="input"
          type="password"
          id="reset-pw-pass"
          name="password"
          autocomplete="new-password"
          minlength="6"
          required
        />
        <label class="reset-pw-label" for="reset-pw-pass2">Пароль ещё раз</label>
        <input
          class="input"
          type="password"
          id="reset-pw-pass2"
          name="password2"
          autocomplete="new-password"
          minlength="6"
          required
        />
        <button type="submit" class="btn btn--primary reset-pw-submit" id="reset-pw-btn">Сохранить</button>
      </form>
      <p id="reset-pw-done" class="reset-pw-done" hidden>
        Пароль обновлён. <a href="/home">Войти в приложение</a>
      </p>
    </div>
  </div>
  <script is:inline>
    (function () {
      var params = new URLSearchParams(location.search);
      var token = params.get("token");
      var form = document.getElementById("form-reset-pw");
      var errEl = document.getElementById("reset-pw-error");
      var doneEl = document.getElementById("reset-pw-done");
      var lead = document.getElementById("reset-pw-lead");
      var btn = document.getElementById("reset-pw-btn");

      function showErr(msg) {
        if (!errEl) return;
        errEl.textContent = msg || "";
        errEl.hidden = !msg;
      }

      if (!token || token.length < 64) {
        if (lead) lead.textContent = "Ссылка неполная или устарела.";
        if (form) form.hidden = true;
        showErr("Запросите новое письмо в разделе «Забыли пароль?».");
        return;
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        showErr("");
        var p1 = document.getElementById("reset-pw-pass");
        var p2 = document.getElementById("reset-pw-pass2");
        var a = p1 ? String(p1.value) : "";
        var b = p2 ? String(p2.value) : "";
        if (a.length < 6) {
          showErr("Пароль не короче 6 символов");
          return;
        }
        if (a !== b) {
          showErr("Пароли не совпадают");
          return;
        }
        if (btn) {
          btn.disabled = true;
          btn.textContent = "Сохранение…";
        }
        fetch("/api/auth/reset-password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token: token, password: a }),
        })
          .then(function (res) {
            return res.json().then(function (d) {
              return { ok: res.ok, d: d };
            });
          })
          .then(function (x) {
            if (!x.ok) throw new Error(x.d && x.d.error ? x.d.error : "Ошибка");
            if (form) form.hidden = true;
            if (lead) lead.hidden = true;
            if (doneEl) doneEl.hidden = false;
          })
          .catch(function (err) {
            showErr(err.message || "Ошибка");
            if (btn) {
              btn.disabled = false;
              btn.textContent = "Сохранить";
            }
          });
      });
    })();
  </script>
</Base>

<style>
  .reset-pw-page {
    min-height: 100dvh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: max(24px, env(safe-area-inset-top)) 20px max(32px, env(safe-area-inset-bottom));
    box-sizing: border-box;
    background: var(--bg, #f5f5f7);
  }
  .reset-pw-card {
    width: 100%;
    max-width: 400px;
    background: var(--surface, #fff);
    border-radius: 16px;
    padding: 24px 20px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(15, 23, 42, 0.06);
  }
  .reset-pw-title {
    margin: 0 0 8px;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .reset-pw-lead {
    margin: 0 0 16px;
    font-size: 0.92rem;
    color: var(--text-muted, #64748b);
    line-height: 1.45;
  }
  .reset-pw-error {
    margin: 0 0 12px;
    font-size: 0.88rem;
    color: #b91c1c;
    line-height: 1.35;
  }
  .reset-pw-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .reset-pw-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted, #64748b);
  }
  .reset-pw-submit {
    margin-top: 12px;
    width: 100%;
  }
  .reset-pw-done {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .reset-pw-done a {
    color: var(--apple-blue, #0071e3);
    font-weight: 600;
  }
</style>
