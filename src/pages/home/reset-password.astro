---
import Base from "../../layouts/Base.astro";
---

<Base title="Новый пароль" description="Установите новый пароль по ссылке из письма.">
  <script is:inline>
    try {
      if (localStorage.getItem("ab_theme") === "dark") document.documentElement.classList.add("theme-dark");
    } catch (e) {}
  </script>
  <div class="reset-pw-page">
    <a class="reset-pw-back" href="/home">
      <svg class="reset-pw-back__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      На главную
    </a>

    <div class="reset-pw-card">
      <div class="reset-pw-card__accent" aria-hidden="true"></div>

      <div id="reset-pw-state-form">
        <div class="reset-pw-hero" aria-hidden="true">
          <div class="reset-pw-hero__glow"></div>
          <div class="reset-pw-hero__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
        </div>
        <h1 class="reset-pw-title">Новый пароль</h1>
        <p id="reset-pw-lead" class="reset-pw-lead">Придумайте пароль для входа по телефону — не короче 6 символов.</p>
        <div id="reset-pw-error" class="reset-pw-alert reset-pw-alert--err" role="alert" hidden>
          <svg class="reset-pw-alert__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 8v4M12 16h.01"></path>
          </svg>
          <span id="reset-pw-error-text"></span>
        </div>
        <form id="form-reset-pw" class="reset-pw-form" novalidate>
          <div class="reset-pw-field">
            <label class="reset-pw-field__label" for="reset-pw-pass">
              <span class="reset-pw-field__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                </svg>
              </span>
              Пароль
            </label>
            <input
              class="input reset-pw-field__input"
              type="password"
              id="reset-pw-pass"
              name="password"
              autocomplete="new-password"
              minlength="6"
              required
              placeholder="••••••••"
            />
          </div>
          <div class="reset-pw-field">
            <label class="reset-pw-field__label" for="reset-pw-pass2">
              <span class="reset-pw-field__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l.8-.8a1 1 0 0 0 0-1.4l-2.3-2.3"></path>
                  <path d="M9 11l6-6a2.1 2.1 0 0 1 2.8 0L19 6.2a2.1 2.1 0 0 1 0 2.8l-6 6"></path>
                  <path d="m7 13-4 4v3h3l4-4"></path>
                </svg>
              </span>
              Повторите пароль
            </label>
            <input
              class="input reset-pw-field__input"
              type="password"
              id="reset-pw-pass2"
              name="password2"
              autocomplete="new-password"
              minlength="6"
              required
              placeholder="••••••••"
            />
          </div>
          <button type="submit" class="btn btn--primary reset-pw-submit" id="reset-pw-btn">
            <svg class="reset-pw-submit__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            Сохранить пароль
          </button>
        </form>
      </div>

      <div id="reset-pw-state-bad" class="reset-pw-state-bad" hidden>
        <div class="reset-pw-hero reset-pw-hero--warn" aria-hidden="true">
          <div class="reset-pw-hero__glow reset-pw-hero__glow--warn"></div>
          <div class="reset-pw-hero__icon reset-pw-hero__icon--warn">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <path d="M12 9v4M12 17h.01"></path>
            </svg>
          </div>
        </div>
        <h1 class="reset-pw-title">Ссылка недействительна</h1>
        <p class="reset-pw-lead">Запросите новое письмо в окне входа — пункт «Забыли пароль?».</p>
        <a class="btn btn--primary reset-pw-cta" href="/home">Перейти ко входу</a>
      </div>

      <div id="reset-pw-done" class="reset-pw-done" hidden>
        <div class="reset-pw-hero reset-pw-hero--ok" aria-hidden="true">
          <div class="reset-pw-hero__glow reset-pw-hero__glow--ok"></div>
          <div class="reset-pw-hero__icon reset-pw-hero__icon--ok">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
        </div>
        <h1 class="reset-pw-title">Готово</h1>
        <p class="reset-pw-lead reset-pw-lead--tight">Пароль обновлён. Войдите с новым паролем.</p>
        <a class="btn btn--primary reset-pw-cta" href="/home">
          <svg class="reset-pw-submit__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
          Войти в приложение
        </a>
      </div>
    </div>
  </div>
  <script is:inline>
    (function () {
      var params = new URLSearchParams(location.search);
      var token = params.get("token");
      var form = document.getElementById("form-reset-pw");
      var errBox = document.getElementById("reset-pw-error");
      var errText = document.getElementById("reset-pw-error-text");
      var doneEl = document.getElementById("reset-pw-done");
      var lead = document.getElementById("reset-pw-lead");
      var btn = document.getElementById("reset-pw-btn");
      var stateForm = document.getElementById("reset-pw-state-form");
      var stateBad = document.getElementById("reset-pw-state-bad");

      function showErr(msg) {
        if (!errBox || !errText) return;
        errText.textContent = msg || "";
        errBox.hidden = !msg;
      }

      if (!token || token.length < 64) {
        if (stateForm) stateForm.hidden = true;
        if (stateBad) stateBad.hidden = false;
        return;
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        showErr("");
        var p1 = document.getElementById("reset-pw-pass");
        var p2 = document.getElementById("reset-pw-pass2");
        var a = p1 ? String(p1.value) : "";
        var b = p2 ? String(p2.value) : "";
        if (a.length < 6) {
          showErr("Пароль не короче 6 символов.");
          return;
        }
        if (a !== b) {
          showErr("Пароли не совпадают.");
          return;
        }
        if (btn) {
          btn.disabled = true;
          btn.innerHTML =
            '<span class="reset-pw-spinner" aria-hidden="true"></span><span>Сохранение…</span>';
        }
        fetch("/api/auth/reset-password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token: token, password: a }),
        })
          .then(function (res) {
            return res.json().then(function (d) {
              return { ok: res.ok, d: d };
            });
          })
          .then(function (x) {
            if (!x.ok) throw new Error(x.d && x.d.error ? x.d.error : "Ошибка");
            if (stateForm) stateForm.hidden = true;
            if (lead) lead.hidden = true;
            if (doneEl) doneEl.hidden = false;
          })
          .catch(function (err) {
            showErr(err.message || "Ошибка");
            if (btn) {
              btn.disabled = false;
              btn.innerHTML =
                '<svg class="reset-pw-submit__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>Сохранить пароль';
            }
          });
      });
    })();
  </script>
</Base>

<style>
  .reset-pw-page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: max(12px, env(safe-area-inset-top)) 20px max(40px, env(safe-area-inset-bottom));
    box-sizing: border-box;
    background: radial-gradient(120% 80% at 50% -20%, color-mix(in srgb, var(--apple-blue, #0071e3) 18%, transparent), transparent),
      linear-gradient(180deg, color-mix(in srgb, var(--surface, #fff) 88%, var(--bg, #f5f5f7)) 0%, var(--bg, #f5f5f7) 45%);
  }

  .reset-pw-back {
    align-self: flex-start;
    max-width: 420px;
    width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted, #64748b);
    text-decoration: none;
    padding: 8px 4px;
    border-radius: 10px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .reset-pw-back:hover {
    color: var(--apple-blue, #0071e3);
    background: color-mix(in srgb, var(--apple-blue, #0071e3) 8%, transparent);
  }
  .reset-pw-back__icon {
    flex-shrink: 0;
    opacity: 0.85;
  }

  .reset-pw-card {
    position: relative;
    width: 100%;
    max-width: 420px;
    background: var(--surface, #fff);
    border-radius: 22px;
    padding: 28px 24px 26px;
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.08), 0 0 0 1px color-mix(in srgb, var(--text, #0f172a) 6%, transparent);
    overflow: hidden;
  }

  .reset-pw-card__accent {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
    background: linear-gradient(90deg, #2563eb, #7c3aed, #db2777);
    opacity: 0.9;
  }

  .reset-pw-hero {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
    position: relative;
  }
  .reset-pw-hero__glow {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--apple-blue, #0071e3) 35%, transparent) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .reset-pw-hero__glow--warn {
    background: radial-gradient(circle, color-mix(in srgb, #f59e0b 40%, transparent) 0%, transparent 70%);
  }
  .reset-pw-hero__glow--ok {
    background: radial-gradient(circle, color-mix(in srgb, #16a34a 38%, transparent) 0%, transparent 70%);
  }
  .reset-pw-hero__icon {
    position: relative;
    width: 72px;
    height: 72px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1d4ed8;
    background: linear-gradient(145deg, #eff6ff 0%, #dbeafe 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8), 0 8px 24px rgba(37, 99, 235, 0.2);
  }
  .reset-pw-hero__icon--warn {
    color: #b45309;
    background: linear-gradient(145deg, #fffbeb 0%, #fef3c7 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), 0 8px 24px rgba(245, 158, 11, 0.22);
  }
  .reset-pw-hero__icon--ok {
    color: #15803d;
    background: linear-gradient(145deg, #f0fdf4 0%, #dcfce7 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8), 0 8px 24px rgba(22, 163, 74, 0.2);
  }

  .reset-pw-title {
    margin: 0 0 10px;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-align: center;
    color: var(--text, #0f172a);
  }
  .reset-pw-lead {
    margin: 0 0 22px;
    font-size: 0.94rem;
    color: var(--text-muted, #64748b);
    line-height: 1.5;
    text-align: center;
    max-width: 32ch;
    margin-left: auto;
    margin-right: auto;
  }
  .reset-pw-lead--tight {
    margin-bottom: 20px;
  }

  .reset-pw-alert {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 14px;
    margin-bottom: 18px;
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .reset-pw-alert--err {
    background: color-mix(in srgb, #ef4444 10%, var(--surface, #fff));
    color: #b91c1c;
    border: 1px solid color-mix(in srgb, #ef4444 22%, transparent);
  }
  .reset-pw-alert__icon {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .reset-pw-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .reset-pw-field__label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted, #64748b);
    margin-bottom: 8px;
  }
  .reset-pw-field__icon {
    display: flex;
    color: var(--apple-blue, #0071e3);
    opacity: 0.85;
  }
  .reset-pw-field__input {
    width: 100%;
    box-sizing: border-box;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 1rem;
  }

  .reset-pw-submit {
    margin-top: 4px;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 20px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 14px;
  }
  .reset-pw-submit__icon {
    flex-shrink: 0;
    opacity: 0.95;
  }

  .reset-pw-spinner {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: reset-pw-spin 0.7s linear infinite;
  }
  @keyframes reset-pw-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .reset-pw-done .reset-pw-title,
  .reset-pw-state-bad .reset-pw-title {
    margin-top: 4px;
  }
  .reset-pw-cta {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 20px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 14px;
    text-decoration: none;
    box-sizing: border-box;
  }

  .reset-pw-state-bad {
    text-align: center;
  }
  .reset-pw-state-bad .reset-pw-lead {
    margin-bottom: 24px;
  }

  :global(html.theme-dark) .reset-pw-page {
    background: radial-gradient(100% 70% at 50% -15%, color-mix(in srgb, var(--apple-blue, #0071e3) 22%, transparent), transparent),
      linear-gradient(180deg, var(--surface, #16161d) 0%, var(--bg, #0c0c10) 50%);
  }
  :global(html.theme-dark) .reset-pw-card {
    box-shadow: 0 24px 56px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  :global(html.theme-dark) .reset-pw-hero__icon {
    background: linear-gradient(145deg, #1e3a5f 0%, #172554 100%);
    color: #93c5fd;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 8px 28px rgba(0, 0, 0, 0.35);
  }
  :global(html.theme-dark) .reset-pw-hero__icon--warn {
    background: linear-gradient(145deg, #422006 0%, #451a03 100%);
    color: #fcd34d;
  }
  :global(html.theme-dark) .reset-pw-hero__icon--ok {
    background: linear-gradient(145deg, #052e16 0%, #14532d 100%);
    color: #86efac;
  }
  :global(html.theme-dark) .reset-pw-alert--err {
    background: color-mix(in srgb, #ef4444 14%, var(--surface, #16161d));
    color: #fca5a5;
    border-color: color-mix(in srgb, #ef4444 35%, transparent);
  }
  :global(html.theme-dark) .reset-pw-back:hover {
    background: color-mix(in srgb, var(--apple-blue, #0071e3) 14%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .reset-pw-spinner {
      animation: none;
      border-top-color: rgba(255, 255, 255, 0.6);
    }
  }
</style>
