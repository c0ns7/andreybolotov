---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Дополнительные скрипты после основного (например /js/admin-raffles.js на странице админки) */
  extraScripts?: string[];
}

const { title, description, extraScripts = [] } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ffffff" />
    {description ? <meta name="description" content={description} /> : null}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script src="/js/admin.js" defer></script>
    {extraScripts.map((src) => <script src={src} defer />)}
  </body>
</html>
