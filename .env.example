# Публичный URL сайта (ссылка в письме «сброс пароля»)
APP_PUBLIC_URL=https://andreybolotov.ru

# SMTP
# Mail.ru / @internet.ru / @bk.ru: в SMTP_PASS указывайте только «Пароль для внешнего приложения»
# (Почта → Настройки → Безопасность). Обычный пароль входа в ящик для SMTP выдаёт 535 Application password is REQUIRED.
# https://help.mail.ru/mail/security/protection/external
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=you@internet.ru
SMTP_PASS=
# От кого (для Mail.ru обычно тот же адрес, что и SMTP_USER, или задайте явно)
# SMTP_FROM="Имя <you@internet.ru>"
# По умолчанию для порта 587 включён requireTLS. Если провайдер ругается — SMTP_REQUIRE_TLS=0
# SMTP_REQUIRE_TLS=0
# Только для отладки с самоподписанным TLS: SMTP_TLS_REJECT_UNAUTHORIZED=0
# Подробный лог SMTP в консоль: SMTP_DEBUG=1
# Повторы отправки и лог сбоев (файл по умолчанию data/mail-failures.log)
# SMTP_MAX_ATTEMPTS=4
# MAIL_FAILURE_LOG=data/mail-failures.log

PORT=3000

# За сколько минут до конца брони отправить e-mail (0 = не отправлять). Нужны SMTP и включённые «Новые акции» в настройках почты пользователя.
# RAFFLE_RESERVE_REMINDER_MINUTES=5

# Сколько минут даётся на новый чек после «Отклонить чек» в админке (не меньше 15)
# RAFFLE_REJECT_REOPEN_MINUTES=1440

# Сколько раз можно вернуть заявку в бронь после отклонения чека; дальше — полная отмена (по умолчанию 3)
# RAFFLE_RECEIPT_REJECT_MAX=3

# Текст подсказки «обычно проверка до N ч» (письма, API, тост после отправки чека; по умолчанию 24)
# RAFFLE_RECEIPT_REVIEW_HOURS=24

# Секрет для GET /api/internal/cron/raffle-mail-tick?secret=… (напоминания о брони и др. тики почты)
# CRON_SECRET=

# Не запускать setInterval почты в процессе (1 = только cron-URL выше; удобно при нескольких инстансах)
# DISABLE_RAFFLE_MAIL_INTERVAL=1