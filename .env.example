# Публичный URL сайта (ссылка в письме «сброс пароля»)
APP_PUBLIC_URL=https://andreybolotov.ru

# SMTP
# Mail.ru / @internet.ru / @bk.ru: в SMTP_PASS указывайте только «Пароль для внешнего приложения»
# (Почта → Настройки → Безопасность). Обычный пароль входа в ящик для SMTP выдаёт 535 Application password is REQUIRED.
# https://help.mail.ru/mail/security/protection/external
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=you@internet.ru
SMTP_PASS=
# От кого (для Mail.ru обычно тот же адрес, что и SMTP_USER, или задайте явно)
# SMTP_FROM="Имя <you@internet.ru>"
# По умолчанию для порта 587 включён requireTLS. Если провайдер ругается — SMTP_REQUIRE_TLS=0
# SMTP_REQUIRE_TLS=0
# Только для отладки с самоподписанным TLS: SMTP_TLS_REJECT_UNAUTHORIZED=0
# Подробный лог SMTP в консоль: SMTP_DEBUG=1

PORT=3000