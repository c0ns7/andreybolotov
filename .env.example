# Dual-host: andreybolotov.ru (прямой) + my.andreybolotov.ru (Beeline CDN)
# Не задавайте NEXT_PUBLIC_CDN_ORIGIN / assetPrefix — оба домена отдают свой /_next и /uploads.

# Upstream API (Fastify), обычно localhost
# AB_UPSTREAM_ORIGIN=http://127.0.0.1:8787

# Оставьте пустыми, чтобы API/WS шли на текущий хост (my. или apex):
# NEXT_PUBLIC_AB_WS_ORIGIN=
# NEXT_PUBLIC_AB_HTTP_ORIGIN=

# Только если uploads обходят Cloudflare (~100 МБ лимит):
# NEXT_PUBLIC_AB_UPLOAD_ORIGIN=https://api.andreybolotov.ru

# Каноникал для писем / SEO (не влияет на вход с my.):
# APP_PUBLIC_URL=https://andreybolotov.ru
# SITE_URL=https://andreybolotov.ru

# Beeline CDN (кабинет, не env):
# - CNAME my → *.a.trbcdn.net, Let's Encrypt на my.
# - Rules: /api/* и HTML — не кешировать; /uploads и /_next/static — долго.
# - После смены правил — полная очистка кэша.
# - WebSocket на my. может не пройти через CDN; чат на apex при этом работает.
